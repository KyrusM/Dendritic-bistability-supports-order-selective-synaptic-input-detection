6b5bfc2006d9"],

Cell["\<\
plotIVu1Thev plots membrane and total currents for the segment nearer the \
plateau front, using the equivalent loads of the adjoining chains.\
\>", "Text",ExpressionUUID->"dabc35e5-1277-4a6c-b3ab-1773cb0af5e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotIVu1Thev", "[", "repval_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "roots", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"roots", "=", 
      RowBox[{"SolveValues", "[", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "\[ScriptR]"}], ")"}], 
              RowBox[{
               SubscriptBox["f", "GIRK"], "[", 
               RowBox[{"mVto", "[", 
                RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", "\[ScriptR]"}], ")"}], 
              RowBox[{
               SubscriptBox["f", "NMDA"], "[", 
               RowBox[{"mVto", "[", 
                RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "+", 
             RowBox[{
              SubscriptBox["g", "dis"], 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["e", "NMDA"], "-", 
                RowBox[{"mVto", "[", 
                 RowBox[{"u", " ", "mV"}], "]"}]}], ")"}]}], "+", 
             RowBox[{
              SuperscriptBox["\[ScriptL]", "2"], 
              FractionBox[
               RowBox[{
                SubscriptBox["e", "GIRK"], "-", 
                RowBox[{"mVto", "[", 
                 RowBox[{"u", " ", "mV"}], "]"}]}], 
               SuperscriptBox["\[CapitalDelta]x", "2"]]}]}], "==", "0"}], 
           ")"}], "/.", "repval"}], "]"}], ",", "u", ",", "Reals"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[ScriptR]"}], ")"}], 
                 RowBox[{
                  SubscriptBox["f", "GIRK"], "[", 
                  RowBox[{"mVto", "[", 
                   RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "\[ScriptR]"}], ")"}], 
                 RowBox[{
                  SubscriptBox["f", "NMDA"], "[", 
                  RowBox[{"mVto", "[", 
                   RowBox[{"u", " ", "mV"}], "]"}], "]"}]}]}], ")"}]}], "/.", 
             "repval"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[ScriptR]"}], ")"}], 
                 RowBox[{
                  SubscriptBox["f", "GIRK"], "[", 
                  RowBox[{"mVto", "[", 
                   RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "+", "\[ScriptR]"}], ")"}], 
                 RowBox[{
                  SubscriptBox["f", "NMDA"], "[", 
                  RowBox[{"mVto", "[", 
                   RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "+", 
                RowBox[{
                 SubscriptBox["g", "dis"], 
                 RowBox[{"(", 
                  RowBox[{
                   SubscriptBox["e", "NMDA"], "-", 
                   RowBox[{"mVto", "[", 
                    RowBox[{"u", " ", "mV"}], "]"}]}], ")"}]}], "+", 
                RowBox[{
                 SuperscriptBox["\[ScriptL]", "2"], 
                 FractionBox[
                  RowBox[{
                   SubscriptBox["e", "GIRK"], "-", 
                   RowBox[{"mVto", "[", 
                    RowBox[{"u", " ", "mV"}], "]"}]}], 
                  SuperscriptBox["\[CapitalDelta]x", "2"]]}]}], 
               "\[IndentingNewLine]", ")"}]}], "/.", "repval"}]}], 
           "\[IndentingNewLine]", "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", 
           RowBox[{"-", "100"}], ",", "10"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AspectRatio", "->", 
