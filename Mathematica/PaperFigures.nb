Cell[CellGroupData[{

Cell["Supplementary Figure 2", \
"Section",ExpressionUUID->"f6f9efe7-9de1-414e-aaeb-d8193546fec5"],

Cell["\<\
Calculate electrotonic length and plot its contours across dendritic diameter \
and channel conductance density.\
\>", "Text",ExpressionUUID->"6d9158f6-e1cd-418e-b162-175273f57113"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lc", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[ScriptCapitalG]c", " ", "nS"}], ")"}], " ", 
         "\[ScriptCapitalR]s"}], "\[Mu]m"]]], "/.", "\[VeryThinSpace]", 
     RowBox[{"\[ScriptCapitalR]s", "\[Rule]", 
      FractionBox["Rax", 
       RowBox[{"\[Pi]", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"d", " ", "\[Mu]m"}], "2"], ")"}], "2"]}]]}]}], "/.", 
    "\[VeryThinSpace]", 
    RowBox[{"Rax", "\[Rule]", 
     FractionBox[
      RowBox[{"400", " ", "\[CapitalOmega]", " ", "cm", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["10", "4"], " ", "\[Mu]m"}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["10", "9"], " ", "nS", " ", "\[CapitalOmega]"}], 
        ")"}], " ", "cm"}]]}]}]}], ";"}]], "Input",
 InitializationCell->
  False,ExpressionUUID->"85af6523-ba61-4210-967f-ad12c2ddc7f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"savePanels", "[", 
  RowBox[{
   RowBox[{"{", "\"\<FigS2.svg\>\"", "}"}], ",", 
   RowBox[{
    RowBox[{"ticks", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
