Cell[CellGroupData[{

Cell["Phase Portraits", "Section",
 CellChangeTimes->{{3.981572211700529*^9, 
  3.981572215331956*^9}},ExpressionUUID->"c14f7fda-dd07-4b95-a9e5-\
f63d1e408721"],

Cell["\<\
phasePortraits plots the equilibria, separatrices and input-driven \
trajectories of the two segments ahead of the front.\
\>", "Text",ExpressionUUID->"bfb04778-5ba3-4270-81a8-d4831043e882"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phasePortraits", "[", "\[ScriptCapitalT]_", "]"}], "[", 
    RowBox[{"repval_", ",", " ", 
     RowBox[{"plotInputs_", ":", "True"}]}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "urangex", ",", " ", "urangey", ",", " ", "rhs1", ",", " ", "rhs2", ",",
        " ", "rawSols", ",", " ", "pts", ",", " ", "uniquePts", ",", " ", 
       "sols", ",", " ", "J", ",", " ", "nc", ",", " ", "ptsGraphics", ",", 
       " ", "fieldPlot", ",", "\n", "     ", "sepPts", ",", " ", "sepPlot", ",",
        " ", "eq1", ",", " ", "eq2", ",", " ", "solns", ",", " ", "pp1", ",", 
       " ", "pp2", ",", " ", "\[ScriptCapitalT]v"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"urangex", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1.3"}], ",", " ", "1.3"}], "}"}]}], ";", "\n", "    ", 
      
      RowBox[{"urangey", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1.3"}], ",", " ", "1.3"}], "}"}]}], ";", "\n", "    ", 
      
      RowBox[{"rhs1", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", "\[ScriptR]"}], ")"}], " ", "*", " ", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"f", ",", " ", "NMDA"}], "]"}], "[", 
          RowBox[{
           RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}], "]"}]}], " ", "+", 
        " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "\[ScriptR]"}], ")"}], " ", "*", " ", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"f", ",", " ", "GIRK"}], "]"}], "[", 
          RowBox[{
           RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}], "]"}]}], " ", "+", 
        " ", 
        RowBox[{
         RowBox[{"Subscript", "[", "\n", "      ", 
          RowBox[{"g", ",", " ", "dis"}], "]"}], " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"e", ",", " ", "NMDA"}], "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}]}], ")"}]}], " ", "+",
         " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[ScriptL]", " ", "/", " ", "\[CapitalDelta]x"}], ")"}], 
          " ", "^", " ", "2"}], " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "2", "]"}], "[", "t", "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}]}], ")"}]}]}]}], ";",
       "\n", "    ", 
      RowBox[{"rhs2", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", "\[ScriptR]"}], ")"}], " ", "*", " ", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"f", ",", " ", "NMDA"}], "]"}], "[", 
          RowBox[{
           RowBox[{"u", "[", "2", "]"}], "[", "t", "]"}], "]"}]}], " ", "+", 
        " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "\[ScriptR]"}], ")"}], " ", "*", " ", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"f", ",", " ", "GIRK"}], "]"}], "[", 
          RowBox[{
           RowBox[{"u", "[", "2", "]"}], "[", "t", "]"}], "]"}]}], " ", "+", 
        " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[ScriptL]", " ", "/", " ", "\[CapitalDelta]x"}], ")"}], 
          " ", "^", "\n", "       ", "2"}], " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"u", "[", "2", "]"}], "[", "t", "]"}]}], ")"}]}], " ", "+",
         " ", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"g", ",", " ", "prx"}], "]"}], " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"e", ",", " ", "GIRK"}], "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"u", "[", "2", "]"}], "[", "t", "]"}]}], ")"}]}]}]}], ";",
       "\n", "    ", 
      RowBox[{"rawSols", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"FindRoot", "[", 
            RowBox[{
             RowBox[{"Evaluate", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"rhs1", " ", "==", " ", "0"}], ",", " ", 
                 RowBox[{"rhs2", " ", "==", " ", "0"}]}], "}"}], " ", "/.", 
               " ", "repval"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}], ",", " ", 
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"u", "[", "2", "]"}], "[", "\n", "      ", "t", 
                  "]"}], ",", " ", 
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "}"}]}], "]"}], 
           "&"}], ")"}], " ", "/@", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", 
               RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", 
               RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1"}], "}"}]}], 
            "]"}], ",", " ", "1"}], "]"}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"rawSols", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{"rawSols", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"rhs1", "^", "2"}], " ", "+", " ", 
              RowBox[{"rhs2", "^", "2"}]}], " ", "<", " ", "0.0001"}], " ", "/.",
             " ", "repval"}], " ", "/.", " ", "#1"}], "&"}]}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"pts", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"u", "[", "2", "]"}], "[", "t", "]"}]}], "}"}], " ", "/.",
          " ", "rawSols"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"uniquePts", " ", "=", " ", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"pts", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"EuclideanDistance", "[", 
            RowBox[{"#1", ",", " ", "#2"}], "]"}], " ", "<", " ", "0.1"}], 
          "&"}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"sols", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}], ",", " ", 
              RowBox[{
               RowBox[{"u", "[", "2", "]"}], "[", "t", "]"}]}], "}"}], " ", "->",
             " ", "#1"}], "]"}], "&"}], ")"}], " ", "/@", " ", 
        "uniquePts"}]}], ";", "\n", "    ", 
      RowBox[{"J", " ", "=", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rhs1", ",", " ", "rhs2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"u", "[", "2", "]"}], "[", "t", "]"}]}], "}"}], "}"}]}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"nc", " ", "=", " ", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"rhs2", " ", "==", " ", "0"}], ",", " ", 
             RowBox[{"rhs1", " ", "==", " ", "0"}]}], "}"}], " ", "/.", " ", 
           "repval"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "2", "]"}], "[", "t", "]"}], ",", " ", 
           RowBox[{"urangex", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"urangex", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "\n", "      ", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "1", "]"}], "[", "t", "]"}], ",", " ", 
           RowBox[{"urangey", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"urangey", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"ContourStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Lighter", "[", "Purple", "]"}], ",", " ", 
              RowBox[{"Thickness", "[", "0.004", "\n", "      ", "]"}]}], 
             "]"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Lighter", "[", "Brown", "]"}], ",", " ", 
              RowBox[{"Thickness", "[", "0.004", "]"}]}], "]"}]}], "}"}]}]}], 
