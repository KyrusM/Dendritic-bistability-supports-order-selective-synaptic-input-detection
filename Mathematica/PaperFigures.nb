Cell["\<\
Express NMDA and GIRK conductances in terms of their mean and normalized \
imbalance.\
\>", "Text",ExpressionUUID->"506b8cd7-c68c-4fd7-8994-7dadc3352c92"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ChGtoGcr", "=", 
  RowBox[{"Simplify", "@", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["G", "c"], "==", 
         FractionBox[
          RowBox[{
           SubscriptBox["G", "NMDA"], "+", 
           SubscriptBox["G", "GIRK"]}], "2"]}], ",", 
        RowBox[{"\[ScriptR]", "==", 
         FractionBox[
          RowBox[{
           SubscriptBox["G", "NMDA"], "-", 
           SubscriptBox["G", "GIRK"]}], 
          RowBox[{
           SubscriptBox["G", "NMDA"], "+", 
           SubscriptBox["G", "GIRK"]}]]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["G", "NMDA"], ",", 
        SubscriptBox["G", "GIRK"]}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
 InitializationCell->True,
