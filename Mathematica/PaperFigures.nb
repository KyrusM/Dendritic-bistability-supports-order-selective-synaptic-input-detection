Cell["Coactive NMDA and GIRK channels ", "Text",
 CellChangeTimes->{{3.9858351036858587`*^9, 3.985835151822857*^9}, {
  3.985887256270895*^9, 
  3.985887261793746*^9}},ExpressionUUID->"4d0100c0-3689-42c8-90ee-\
