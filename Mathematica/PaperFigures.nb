Defines the voltage-dependent NMDA and GIRK currents and the transient AMPA \
current used throughout the model. \
\>", "Text",
 CellChangeTimes->{{3.9858349777042017`*^9, 
  3.985835002745572*^9}},ExpressionUUID->"cb87d065-0952-47d5-8687-\
eea22c232089"],

Cell[CellGroupData[{

Cell[TextData[{
 "Voltage Scaling: mVto[v], tomV[vv], ",
 Cell[BoxData[
  FormBox[
   RowBox[{"hato", "[", "\[ScriptU]\[ScriptH]\[ScriptA]", "]"}], 
   TraditionalForm]],ExpressionUUID->"2943ccaa-750c-4c55-bc6a-2c87bc0290ec"],
 ": "
}], "Subsubsection",
 CellChangeTimes->{{3.903021591948151*^9, 3.903021624440539*^9}, 
   3.903021681306192*^9, {3.903023008205669*^9, 3.903023078619598*^9}, {
   3.9030235621610813`*^9, 3.9030235621991796`*^9}, {3.981505075220093*^9, 
   3.981505089267085*^9}},ExpressionUUID->"2fc5571a-f060-4614-92f1-\
d639cc19d456"],

Cell[TextData[{
 "Normalizes voltages from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "GIRK"], TraditionalForm]],ExpressionUUID->
  "25c0b321-e99c-43e9-8c1a-ad31e72cdd31"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "NMDA"], TraditionalForm]],ExpressionUUID->
  "4ddac024-0a19-4023-8f5b-a146fa540e39"],
 " to -1 and 1. "
}], "Text",
 CellChangeTimes->{{3.9814825854053383`*^9, 
  3.981482609748642*^9}},ExpressionUUID->"f977bf79-c6eb-48be-96ef-\
df3c27902e9b"],

Cell["\<\
mVto and tomV convert between millivolts and normalized voltage. hato \
converts a voltage slope to the normalized scale.\
\>", "Text",ExpressionUUID->"18eaba2e-e541-4b16-89e2-351076968b34"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mVto", "[", "v_", "]"}], " ", ":=", "\n", "  ", 
    RowBox[{
     RowBox[{"2", " ", "*", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"v", " ", "-", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"NE", ",", " ", "GIRK"}], "]"}]}], ")"}], " ", "/", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"NE", ",", " ", "NMDA"}], "]"}], " ", "-", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"NE", ",", " ", "GIRK"}], "]"}]}], ")"}]}], ")"}]}], " ", "-",
      " ", "1"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tomV", "[", "vv_", "]"}], " ", ":=", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"NE", ",", " ", "NMDA"}], "]"}], " ", "-", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"NE", ",", " ", "GIRK"}], "]"}]}], ")"}], " ", "*", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"vv", " ", "+", " ", "1"}], ")"}], " ", "/", " ", "2"}], 
       ")"}]}], " ", "+", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"NE", ",", " ", "GIRK"}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hato", "[", "v_", "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"2", " ", "*", " ", 
    RowBox[{"(", 
     RowBox[{"v", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"NE", ",", " ", "NMDA"}], "]"}], " ", "-", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"NE", ",", " ", "GIRK"}], "]"}]}], ")"}]}], ")"}]}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.903023080311574*^9, 3.9030230984343777`*^9}, {
   3.9030231675556107`*^9, 3.90302324259573*^9}, {3.903023334560108*^9, 
   3.90302333479436*^9}, {3.903023401758974*^9, 3.903023597984662*^9}, 
   3.9030238170579348`*^9, {3.903024086686138*^9, 3.9030240911805067`*^9}, {
   3.903205755639783*^9, 3.903205763154182*^9}, {3.952699494774579*^9, 
   3.952699572701036*^9}, {3.981486355426497*^9, 3.9814863931970863`*^9}, {
   3.9815050973123407`*^9, 3.981505099373605*^9}, {3.985963854915207*^9, 
   3.985963873409924*^9}, {3.985963907194663*^9, 3.985963908419574*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"6fce13c8-ca99-4b79-8913-91b0b115cf2c"],

