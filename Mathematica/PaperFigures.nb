Cell[BoxData[
 RowBox[{"savePanels", "[", 
  RowBox[{
   RowBox[{"{", "\"\<Fig2Aiv.svg\>\"", "}"}], ",", 
   RowBox[{
    RowBox[{"roots", "=", 
     RowBox[{"SolveValues", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[ScriptF]", "[", 
           RowBox[{"mVto", "[", 
            RowBox[{"u", " ", "mV"}], "]"}], "]"}], "\[Equal]", "0"}], "/.", 
         "\[VeryThinSpace]", 
         RowBox[{"{", 
          RowBox[{"\[ScriptR]", "\[Rule]", "0"}], "}"}]}], "]"}], ",", "u", ",", 
       TemplateBox[{},
        "Reals"]}], "]"}]}], ";", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"\[ScriptF]", "[", 
             RowBox[{"mVto", "[", 
              RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "/.", 
           "\[VeryThinSpace]", 
           RowBox[{"{", 
            RowBox[{"\[ScriptR]", "\[Rule]", "0"}], "}"}]}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", 
          RowBox[{"-", "100"}], ",", "10"}], "}"}], ",", 
        RowBox[{"AspectRatio", "\[Rule]", 
         FractionBox["1", 
          FractionBox[
