             "}"}], " ", "//.", " ", "repval"}], "\n", "      ", "]"}], "]"}],
          ",", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"vars", ",", " ", "spineVars"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", 
           RowBox[{"-", "20"}], ",", " ", "tlim"}], "}"}]}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"u", "[", 
