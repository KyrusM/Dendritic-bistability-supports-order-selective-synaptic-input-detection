Cell[BoxData[
 RowBox[{"savePanels", "[", 
  RowBox[{
   RowBox[{"{", "\"\<Fig2Aii.svg\>\"", "}"}], ",", 
   RowBox[{
    RowBox[{"roots", "=", 
     RowBox[{"SolveValues", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          FractionBox["7", "5"], " ", 
          RowBox[{
           SubscriptBox["f", "GIRK"], "[", 
           RowBox[{"mVto", "[", 
            RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "\[Equal]", "0"}], 
        "]"}], ",", "u", ",", 
       TemplateBox[{},
        "Reals"]}], "]"}]}], ";", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Plot", "[", 
