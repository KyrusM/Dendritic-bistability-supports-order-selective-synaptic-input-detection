             RowBox[{"solveOnce", "[", "pair", "]"}]}], "}"}], ",", "\n", 
           "          ", 
           RowBox[{
            RowBox[{"Evaluate", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"u", "[", "m", "]"}], "[", "t", "]"}], " ", "/.", 
                  " ", "sol"}], ")"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"u", "[", 
                    RowBox[{"2", " ", "*", " ", "m"}], "]"}], "[", "t", "]"}],
                   " ", "/.", " ", "sol"}], ")"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], " ", "/.", 
            " ", 
            RowBox[{"t", " ", "->", " ", "tlim"}]}]}], "\n", "        ", 
          "]"}], "\n", "        ", ",", "\n", "        ", 
