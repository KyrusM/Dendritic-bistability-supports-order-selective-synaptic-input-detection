Cell[CellGroupData[{

Cell["AMPA inputs advancing the plateau", "Subsection",
 CellChangeTimes->{{3.9815684860761023`*^9, 
  3.981568498335404*^9}},ExpressionUUID->"29ebd467-e2ea-4a62-a63e-\
84bddf7f4eec"],

Cell["AMPA inputs advancing or stalling an anchored front.", "Text",
 CellChangeTimes->{{3.9858931356725063`*^9, 
  3.985893182701955*^9}},ExpressionUUID->"437a063c-080e-4a77-8f5d-\
dd5f2678773e"],

Cell[CellGroupData[{

Cell["\<\
Simulating dendrite voltage with channels modelled with a sigmoid with AMPA \
inputs\
\>", "Subsubsection",
 CellChangeTimes->{{3.981517091848668*^9, 3.981517110306123*^9}, {
  3.981568527399633*^9, 
  3.981568531335959*^9}},ExpressionUUID->"cb894f83-e075-482b-8a87-\
9b076c4d3270"],

Cell["\<\
checkAdvanceSig takes input times and model parameters, delivers transient \
AMPA inputs ahead of a front and tests if the front advances. uinit sets the \
initial voltage profile; the plot option displays its evolution.\
\>", "Text",ExpressionUUID->"8a0e13d5-b648-4ea3-9d27-320148a01f56"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"checkAdvanceSig", "[", "\[ScriptCapitalT]_", "]"}], "[", 
    RowBox[{"repval_", ",", " ", "m_", ",", " ", 
     RowBox[{"plot_", ":", "False"}], ",", " ", 
     RowBox[{"offset_", ":", "0"}], ",", " ", 
     RowBox[{"redDotHeight_", ":", "1"}]}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", " ", "nN", ",", " ", "nm", ",", " ", "rnm", ",", " ", "xs", ",",
        " ", "vars", ",", " ", "uinit", ",", " ", "eqs", ",", " ", "tlim", ",",
        " ", "ndsol", ",", " ", "redDotHeightv"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Length", "[", "\[ScriptCapitalT]", "]"}]}], ";", "\n", "    ", 
      RowBox[{"nN", " ", "=", "\n", "      ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[CapitalDelta]x", " ", "/", " ", "\[ScriptL]"}], 
              ")"}], " ", "^", " ", "2"}], " ", "/.", " ", "repval"}], ")"}], 
          " ", ">", " ", "4"}], ",", "\n", "        ", "10", "\n", "        ",
          ",", "\n", "        ", "20"}], "\n", "      ", "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"nm", " ", "=", " ", 
       RowBox[{
        RowBox[{"nN", " ", "*", " ", "m"}], " ", "+", " ", 
        RowBox[{"Floor", "[", 
         RowBox[{"m", " ", "/", " ", "2"}], "]"}]}]}], ";", "\n", "    ", 
      RowBox[{"rnm", " ", "=", " ", 
       RowBox[{
        RowBox[{"n", " ", "*", " ", "m"}], " ", "+", " ", "nm"}]}], ";", "\n",
       "    ", 
      RowBox[{"xs", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "nm"}], ",", " ", "rnm"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"vars", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"-", "nm"}], ",", " ", "rnm"}], "}"}]}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"uinit", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "*", " ", 
           RowBox[{"UnitStep", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", " ", "+", " ", "offset"}], ")"}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"2", " ", "*", " ", "\[ScriptL]"}], ")"}]}], "]"}]}], 
          " ", "-", " ", "1"}], ")"}]}]}], ";", "\n", "    ", 
      RowBox[{"eqs", " ", "=", "\n", "      ", 
       RowBox[{"Table", "[", "\n", "        ", 
        RowBox[{
         RowBox[{
