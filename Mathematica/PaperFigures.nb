Cell[CellGroupData[{

Cell["Channels modeled with a sigmoid", "Subsection",
 CellChangeTimes->{{3.981517049243281*^9, 
  3.9815170539990892`*^9}},ExpressionUUID->"54ed3cc6-77d9-4f6f-b2d7-\
6b81743a283f"],

Cell["\<\
Front anchoring with sigmoid-gated NMDA and GIRK currents (Fig. 3E,F).\
\>", "Text",
 CellChangeTimes->{{3.985891999243325*^9, 3.985892044753621*^9}, 
   3.985892378235805*^9},ExpressionUUID->"f88d8b09-324f-49b0-9404-\
63beb1dc5195"],

Cell[CellGroupData[{

Cell["\<\
Simulating dendrite voltage with channels modelled with a sigmoid\
\>", "Subsubsection",
 CellChangeTimes->{{3.981517091848668*^9, 
  3.981517110306123*^9}},ExpressionUUID->"524eb25d-49b0-4bd8-a615-\
c890136e1e5a"],

Cell[TextData[{
 "Simulates a dendrite with NMDA and GIRK channels localized to synapses \
(when ",
 Cell[BoxData[
 "m"], "InlineCode",ExpressionUUID->"09ac986d-4510-4e0d-81a8-3ccc55b5a8ee"],
 " is 1), or with GIRK channels distributed to ",
 Cell[BoxData[
 "m"], "InlineCode",ExpressionUUID->"b54d8ea2-61f7-49c9-ba9c-32953fff7ca4"],
 " compartments between localized NMDA synapses. "
}], "Text",
 CellChangeTimes->{{3.985892448017728*^9, 
  3.985892519963208*^9}},ExpressionUUID->"69df4692-61c3-4eb5-a9b2-\
f73d3a8c8000"],

Cell["\<\
checkDriftSig evolves a front with sigmoid-gated NMDA and GIRK currents and \
classifies its drift. m sets the shaft subdivisions per synaptic interval; \
uinit sets the initial voltage profile.\
\>", "Text",ExpressionUUID->"15e28374-ae6a-43f9-bc09-1ab2e56e4659"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkDriftSig", "[", 
    RowBox[{"repval_", ",", " ", "m_", ",", " ", 
     RowBox[{"offset_", ":", "0"}]}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nN", ",", " ", "nm", ",", " ", "xs", ",", " ", "vars", ",", " ", 
       "uinit", ",", " ", "eqs", ",", " ", "tlim", ",", " ", "ndsol", ",", 
       " ", "rmax"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"nN", " ", "=", "\n", "      ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[CapitalDelta]x", " ", "/", " ", "\[ScriptL]"}], 
              ")"}], " ", "^", " ", "2"}], " ", "//.", " ", "repval"}], ")"}],
           " ", ">", " ", "4"}], ",", "\n", "        ", "10", "\n", 
         "        ", ",", "\n", "        ", "20"}], "\n", "      ", "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"nm", " ", "=", " ", 
       RowBox[{
        RowBox[{"nN", " ", "*", " ", "m"}], " ", "+", " ", 
        RowBox[{"Floor", "[", 
         RowBox[{"m", " ", "/", " ", "2"}], "]"}]}]}], ";", "\n", "    ", 
      RowBox[{"xs", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "nm"}], ",", " ", "nm"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"vars", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"-", "nm"}], ",", " ", "nm"}], "}"}]}], "]"}]}], ";", "\n",
       "    ", 
      RowBox[{
