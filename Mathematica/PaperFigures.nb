Cell["NMDA channels - voltage gating modeled with a sigmoid", "Text",
 CellChangeTimes->{{3.9858351036858587`*^9, 3.985835105999454*^9}, {
  3.985835149059362*^9, 3.985835149304385*^9}, {3.9858869084762907`*^9, 
