Notebook[{

Cell[CellGroupData[{
Cell["\<\
Dendritic bistability supports order-selective synaptic input detection\
\>", "Title",
 CellChangeTimes->{{3.9859197683342047`*^9, 
  3.985919779267823*^9}},ExpressionUUID->"1306b21b-c4f7-4532-8fa9-\
28967a10e91e"],

Cell["Kyrus R. Mama, Kwabena A. Boahen", "Text",
 CellChangeTimes->{{3.985919785314128*^9, 
  3.985919812473648*^9}},ExpressionUUID->"aedfd591-7932-4211-8614-\
70aa8ed3f342"],

Cell[TextData[{
 "Code used to generate the figures in the manuscript \
\[OpenCurlyDoubleQuote]Dendritic bistability supports order-selective \
synaptic input detection\[CloseCurlyDoubleQuote]. \n",
 StyleBox["Instructions: ",
  FontWeight->"Bold"],
 "To reproduce a figure, run the initialization cells and then within the \
corresponding section, run code sequentially.\n",
 StyleBox["Runtime: ",
  FontWeight->"Bold"],
 "Most figures generate near instantaneously. The parameter sweeps, \
especially those in 3D can take several hours though. Code used to save and \
load the results of each sweep is included. \n",
 StyleBox["Version:",
  FontWeight->"Bold"],
 " This code was written and run in Wolfram version 14.2.1.0, on macOS 26.3. ",
 "\nFor further information on models implemented to generate the figures in \
the paper, refer to the methods section. "
}], "Text",
 CellChangeTimes->{{3.985919834705594*^9, 3.985919974579434*^9}, {
  3.985920937685371*^9, 3.9859211776450243`*^9}, {3.9859212139901857`*^9, 
  3.985921366261045*^9}},ExpressionUUID->"a2806012-6267-4c9b-90d5-\
4e67906011f4"],

Cell[CellGroupData[{

Cell["Setup", "Section",
 CellChangeTimes->{{3.96775282947775*^9, 
  3.9677528309976397`*^9}},ExpressionUUID->"954e05fa-8bb7-4c42-9437-\
86faaa8e53f8"],

Cell["\<\
Locate figure results and plots. savePanel exports a formatted panel; \
savePanels saves and displays the panels produced by a calculation.\
\>", "Text",ExpressionUUID->"a28b5071-8f7c-4ac8-87a5-11dcaaecd379"],

Cell[BoxData[
 RowBox[{
  RowBox[{"paperRoot", "=", 
   RowBox[{"ParentDirectory", "[", 
    RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}], ";", 
  RowBox[{"SetDirectory", "[", "paperRoot", "]"}], ";", 
  RowBox[{
   RowBox[{"figureFolder", "[", "n_", "]"}], ":=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"paperRoot", ",", 
      RowBox[{"\"\<Figure\>\"", "<>", 
       RowBox[{"ToString", "[", "n", "]"}]}]}], "}"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"supplementFolder", "[", "n_", "]"}], ":=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"paperRoot", ",", 
      RowBox[{"\"\<SupplementaryFigure\>\"", "<>", 
       RowBox[{"ToString", "[", "n", "]"}]}]}], "}"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"figureData", "[", "n_", "]"}], ":=", "\"\<results\>\""}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"figureFolder", "[", "n", "]"}], ",", "\"\<plots\>\""}], 
          "}"}], "]"}], "]"}]}], ",", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"figureFolder", "[", "n", "]"}], ",", "\"\<plots\>\""}], 
          "}"}], "]"}], ",", 
        RowBox[{"CreateIntermediateDirectories", "\[Rule]", "True"}]}], 
       "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "8"}], "}"}]}], "]"}], ";", 
  RowBox[{
   RowBox[{"savePanel", "[", 
    RowBox[{"folder_", ",", "name_", ",", "panel_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"directory", ",", "filename", ",", "extension"}], "}"}], ",", 
     RowBox[{
      RowBox[{"directory", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"folder", ",", "\"\<plots\>\""}], "}"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"DirectoryQ", "[", "directory", "]"}]}], ",", 
        RowBox[{"CreateDirectory", "[", 
         RowBox[{"directory", ",", 
          RowBox[{"CreateIntermediateDirectories", "\[Rule]", "True"}]}], 
         "]"}]}], "]"}], ";", 
      RowBox[{"extension", "=", 
       RowBox[{"FileExtension", "[", "name", "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"extension", "\[Equal]", "\"\<\>\""}], ",", 
        RowBox[{"extension", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "panel", "]"}], "===", "Graphics3D"}], 
           ",", "\"\<png\>\"", ",", "\"\<svg\>\""}], "]"}]}]}], "]"}], ";", 
      RowBox[{"filename", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FileExtension", "[", "name", "]"}], 
          "\[Equal]", "\"\<\>\""}], ",", 
         RowBox[{"name", "<>", "\"\<.\>\"", "<>", "extension"}], ",", 
         "name"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"extension", "\[Equal]", "\"\<png\>\""}], "&&", 
         RowBox[{
          RowBox[{"Head", "[", "panel", "]"}], "===", "Graphics3D"}]}], ",", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"directory", ",", "filename"}], "}"}], "]"}], ",", 
          RowBox[{"Rasterize", "[", 
           RowBox[{"panel", ",", "\"\<Image\>\"", ",", 
            RowBox[{"RasterSize", "\[Rule]", "3000"}], ",", 
            RowBox[{"Background", "\[Rule]", "White"}]}], "]"}], 
          ",", "\"\<PNG\>\""}], "]"}], ",", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"directory", ",", "filename"}], "}"}], "]"}], ",", 
          "panel", ",", 
          RowBox[{"ToUpperCase", "[", "extension", "]"}]}], "]"}]}], "]"}], ";",
       "panel"}]}], "]"}]}], ";", 
  RowBox[{"SetAttributes", "[", 
   RowBox[{"savePanels", ",", "HoldRest"}], "]"}], ";", 
  RowBox[{
   StyleBox[
    RowBox[{"savePanels", "::", "count"}], "MessageName"], 
   "=", "\"\<Expected `1` panels; the calculation produced `2`.\>\""}], ";", 
  RowBox[{
   RowBox[{"savePanels", "[", 
    RowBox[{"names_List", ",", "calculation_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"generatedPanels", "=", 
        RowBox[{"{", "}"}]}], ",", "value", ",", "number", ",", "folder"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"value", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Print", "=", 
           RowBox[{"Function", "[", 
            RowBox[{"generatedPanel", ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"generatedPanels", ",", "generatedPanel"}], "]"}], 
              ";"}]}], "]"}]}], "}"}], ",", "calculation"}], "]"}]}], ";", 
      RowBox[{"generatedPanels", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"generatedPanels", ",", 
         RowBox[{
          RowBox[{"MatchQ", "[", 
           RowBox[{"#1", ",", 
            RowBox[{
            "_Graphics", "|", "_Graphics3D", "|", "_Grid", "|", "_Row"}]}], 
           "]"}], "&"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"value", ",", 
          RowBox[{
          "_Graphics", "|", "_Graphics3D", "|", "_Grid", "|", "_Row"}]}], 
         "]"}], ",", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"generatedPanels", ",", "value"}], "]"}]}], "]"}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "generatedPanels", "]"}], "\[NotEqual]", 
         RowBox[{"Length", "[", "names", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           StyleBox[
            RowBox[{"savePanels", "::", "count"}], "MessageName"], ",", 
           RowBox[{"Length", "[", "names", "]"}], ",", 
           RowBox[{"Length", "[", "generatedPanels", "]"}]}], "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"number", "=", 
          RowBox[{"ToExpression", "[", 
           RowBox[{"First", "[", 
            RowBox[{"StringCases", "[", 
             RowBox[{
              RowBox[{
              "names", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
               ",", 
              RowBox[{"DigitCharacter", ".."}]}], "]"}], "]"}], "]"}]}], ";", 
         
         RowBox[{"folder", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"StringStartsQ", "[", 
             RowBox[{
              RowBox[{
              "names", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}],
               ",", "\"\<FigS\>\""}], "]"}], ",", 
            RowBox[{"supplementFolder", "[", "number", "]"}], ",", 
            RowBox[{"figureFolder", "[", "number", "]"}]}], "]"}]}], ";", 
         RowBox[{"savePanel", "[", 
          RowBox[{"folder", ",", 
           RowBox[{
           "names", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "generatedPanels", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "names", "]"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "generatedPanels", "]"}], "\[Equal]", "1"}], ",", 
        RowBox[{"First", "[", "generatedPanels", "]"}], ",", 
        RowBox[{"Column", "[", "generatedPanels", "]"}]}], "]"}]}]}], "]"}]}],
   ";"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[50]:=",ExpressionUUID->"4d3e7b92-65f4-4ab6-93a3-be04faa7f68b"],

