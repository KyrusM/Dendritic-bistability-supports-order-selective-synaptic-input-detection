Cell[CellGroupData[{

Cell["Parameter sweep", \
"Subsubsection",ExpressionUUID->"3b757bb3-b52e-47dc-abdd-4b7b3c9086b4"],

Cell["\<\
calculateAnchoring sweeps spacing, conductance imbalance and neck resistance, \
then saves the Figure 6A anchoring grid.\
\>", "Text",ExpressionUUID->"1e1b6a92-c43a-4b2d-90f6-89f6047b96a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"calculateAnchoring", "[", 
    RowBox[{"placement_", ",", "onShaft_", ",", "mesh_", ",", 
     RowBox[{"depth_", ":", "8"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bounds", ",", "values", ",", "coordinates", ",", "folder"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"bounds", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.1`", ",", "5.`"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.99`"}], ",", "0.99`"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.01`", ",", "12.`"}], "}"}]}], "}"}]}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"values", ",", "coordinates"}], "}"}], "=", 
       RowBox[{"theCut", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"checkDriftSigSpine", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[CapitalDelta]x", "\[Rule]", 
               RowBox[{
                SqrtBox["#1"], " ", "\[ScriptL]"}]}], ",", 
              RowBox[{"\[ScriptR]", "\[Rule]", "#2"}], ",", 
              RowBox[{
               SubscriptBox["R", "nck"], "\[Rule]", 
               FractionBox["#3", 
                SubscriptBox["G", "c"]]}], ",", 
              RowBox[{"\[Tau]", "\[Rule]", "0.001`"}], ",", 
              RowBox[{"\[Tau]h", "\[Rule]", "0.001`"}]}], "}"}], ",", 
            "onShaft", ",", "mesh"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"RsGc", ",", "0.1`", ",", "5.`"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[ScriptR]", ",", 
             RowBox[{"-", "0.99`"}], ",", "0.99`"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"RnckGc", ",", "0.01`", ",", "12.`"}], "}"}]}], "}"}], ",",
          "4", ",", "depth", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "s", ",", "p"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"folder", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "paperRoot", ",", "\"\<Figure6\>\"", ",", "\"\<results\>\""}], "}"}],
         "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"DirectoryQ", "[", "folder", "]"}]}], ",", 
        RowBox[{"CreateDirectory", "[", "folder", "]"}]}], "]"}], ";", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"folder", ",", 
           RowBox[{"\"\<A_\>\"", "<>", "placement", "<>", "\"\<.json\>\""}]}],
           "}"}], "]"}], ",", 
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<classes\>\"", "\[Rule]", 
           RowBox[{"(", 
            RowBox[{"values", "/.", "\[VeryThinSpace]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"r", "\[Rule]", "0"}], ",", 
               RowBox[{"s", "\[Rule]", "1"}], ",", 
               RowBox[{"p", "\[Rule]", "0"}]}], "}"}]}], ")"}]}], ",", 
          RowBox[{"\"\<bounds\>\"", "\[Rule]", "bounds"}], ",", 
          RowBox[{"\"\<depth\>\"", "\[Rule]", "depth"}]}], "]"}], 
        ",", "\"\<RawJSON\>\""}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[89]:=",ExpressionUUID->"999f0834-5237-4e7c-9f30-4423508beb48"]
