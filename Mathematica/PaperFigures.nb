Cell["\<\
Set the NMDA reversal potential, voltage-gating midpoint and slope, then \
convert them to normalized voltage.\
\>", "Text",ExpressionUUID->"02618645-baea-4c5b-b491-629989a13d86"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Subscript", "[", 
     RowBox[{"NE", ",", " ", "NMDA"}], "]"}], " ", "=", " ", 
    RowBox[{"0", " ", "*", " ", "mV"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Subscript", "[", 
     RowBox[{"uha", ",", " ", "NMDA"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "237"}], "/", "10"}], ")"}], " ", "*", " ", "mV"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Subscript", "[", 
     RowBox[{"us", ",", " ", "NMDA"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"125", "/", "10"}], ")"}], " ", "*", " ", "mV"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Subscript", "[", 
     RowBox[{"e", ",", " ", "NMDA"}], "]"}], " ", "=", " ", 
    RowBox[{"mVto", "[", 
     RowBox[{"Subscript", "[", 
      RowBox[{"NE", ",", " ", "NMDA"}], "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Subscript", "[", 
    RowBox[{"\[ScriptU]\[ScriptH]\[ScriptA]", ",", " ", "NMDA"}], "]"}], " ", 
   "=", " ", 
   RowBox[{"mVto", "[", 
    RowBox[{"Subscript", "[", 
     RowBox[{"uha", ",", " ", "NMDA"}], "]"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"Subscript", "[", 
    RowBox[{"\[ScriptU]\[ScriptS]", ",", " ", "NMDA"}], "]"}], " ", "=", " ", 
   
   RowBox[{"hato", "[", 
