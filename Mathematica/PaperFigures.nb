Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"savePanels", "[", 
  RowBox[{
   RowBox[{"{", "\"\<Fig2Ai.svg\>\"", "}"}], ",", 
   RowBox[{
    RowBox[{"roots", "=", 
     RowBox[{"SolveValues", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          FractionBox["3", "5"], " ", 
          RowBox[{
           SubscriptBox["f", "NMDA"], "[", 
           RowBox[{"mVto", "[", 
            RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "\[Equal]", "0"}], 
        "]"}], ",", "u", ",", 
       TemplateBox[{},
        "Reals"]}], "]"}]}], ";", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{
          FractionBox["1", "5"], " ", 
          RowBox[{"(", 
           RowBox[{"-", "3"}], ")"}], " ", 
          RowBox[{
           SubscriptBox["f", "NMDA"], "[", 
           RowBox[{"mVto", "[", 
            RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", 
          RowBox[{"-", "100"}], ",", "10"}], "}"}], ",", 
        RowBox[{"AspectRatio", "\[Rule]", 
         FractionBox["1", 
          FractionBox[
           RowBox[{"3", " ", "GoldenRatio"}], "2"]]}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
