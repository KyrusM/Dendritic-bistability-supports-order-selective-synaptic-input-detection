Cell[CellGroupData[{

Cell["Sweeping helper functions", "Subsection",
 CellChangeTimes->{{3.981520521869855*^9, 
  3.9815205456941853`*^9}},ExpressionUUID->"162a714d-d19d-4614-9515-\
9172358a3733"],

Cell["Routines used to sweep parameter space efficiently. ", "Text",
 CellChangeTimes->{{3.985835029487754*^9, 3.985835049374833*^9}, {
  3.985890835976034*^9, 
  3.985890844027367*^9}},ExpressionUUID->"d4d8b2c3-363b-4143-af80-\
f51795b4cb6a"],

Cell["\<\
recfuncsolND refines a sampled grid and evaluates unresolved points. theCut \
repeats this step across the specified parameter ranges. plotCutBoundary2d \
draws boundaries between the resulting classes.\
\>", "Text",ExpressionUUID->"fdb28139-3102-4cef-b64e-be0b3c990749"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotCutBoundary", "::", "dims"}], " ", "=", 
   " ", "\"\<Expected a two-dimensional grid.\>\""}], ";", " ", 
  RowBox[{
   RowBox[{"recfuncsolND", "[", 
    RowBox[{
    "vals_", ",", " ", "coords_", ",", " ", "func_", ",", " ", "possible_", ",",
      "\n", "   ", "depth_", ",", " ", "mindepth_"}], "]"}], " ", ":=", "\n", 
   "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "curDim", ",", " ", "newDim", ",", " ", "newVals", ",", " ", 
       "newCoords", ",", " ", "result"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"curDim", " ", "=", " ", 
       RowBox[{"Dimensions", "[", "vals", "]"}]}], ";", "\n", "    ", 
      RowBox[{"newDim", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"2", " ", "*", " ", "#1"}], " ", "-", " ", "1"}], "&"}], 
         ")"}], " ", "/@", " ", "curDim"}]}], ";", "\n", "    ", 
      RowBox[{"newVals", " ", "=", " ", 
       RowBox[{"ArrayResample", "[", 
        RowBox[{"vals", ",", " ", "newDim"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"newCoords", " ", "=", " ", 
       RowBox[{"ArrayResample", "[", 
        RowBox[{"coords", ",", " ", 
         RowBox[{"Append", "[", 
          RowBox[{"newDim", ",", " ", 
           RowBox[{"Length", "[", "curDim", "]"}]}], "]"}]}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"result", " ", "=", "\n", "      ", 
       RowBox[{"MapThread", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"val", ",", " ", "coordVec"}], "}"}], ",", "\n", 
           "          ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"MemberQ", "[", 
                 RowBox[{"possible", ",", " ", "val"}], "]"}], " ", "&&", " ", 
                RowBox[{"depth", " ", ">", " ", "mindepth"}]}], ")"}], " ", "||",
               " ", 
              RowBox[{"depth", " ", "<", " ", "mindepth"}]}], ",", "\n", 
             "            ", "val", "\n", "            ", ",", "\n", 
             "            ", 
             RowBox[{"func", " ", "@@", " ", "coordVec"}]}], "\n", 
            "          ", "]"}]}], "\n", "        ", "]"}], "\n", "        ", 
         ",", "\n", "        ", 
         RowBox[{"{", 
          RowBox[{"newVals", ",", " ", "newCoords"}], "}"}], "\n", "        ",
          ",", "\n", "        ", 
         RowBox[{"Length", "[", "curDim", "]"}]}], "\n", "      ", "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"result", ",", " ", "newCoords"}], "}"}]}]}], "\n", "  ", 
    "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"theCut", "[", 
    RowBox[{
    "f_", ",", " ", "varRanges_", ",", " ", "minDepth_", ",", " ", 
     "maxDepth_", ",", " ", "possibilities_"}], "]"}], " ", ":=", "\n", "  ", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", " ", "boundaries", ",", " ", "dims", ",", " ", "corners", ",",
        " ", "initialVals", ",", " ", "vals", ",", " ", "coords"}], "}"}], ",",
      "\n", "    ", 
     RowBox[{
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Length", "[", "varRanges", "]"}]}], ";", "\n", "    ", 
      RowBox[{"boundaries", " ", "=", " ", 
       RowBox[{"varRanges", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"dims", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"2", ",", " ", "n"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"corners", " ", "=", " ", 
       RowBox[{"Tuples", "[", "boundaries", "]"}]}], ";", "\n", "    ", 
      RowBox[{"initialVals", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f", " ", "@@", " ", "#1"}], "&"}], ")"}], " ", "/@", " ", 
        "corners"}]}], ";", "\n", "    ", 
      RowBox[{"vals", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"initialVals", ",", " ", "dims"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"coords", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"corners", ",", " ", 
         RowBox[{"Append", "[", 
          RowBox[{"dims", ",", " ", "n"}], "]"}]}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"Do", "[", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"Print", "[", "d", "]"}], ";", "\n", "      ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vals", ",", " ", "coords"}], "}"}], " ", "=", " ", 
          RowBox[{"recfuncsolND", "[", 
           RowBox[{
           "vals", ",", " ", "coords", ",", " ", "f", ",", " ", 
            "possibilities", ",", " ", "d", ",", " ", "minDepth"}], "]"}]}]}],
         "\n", "      ", ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "2", ",", " ", "maxDepth"}], "}"}]}], "\n", 
       "    ", "]"}], ";", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"vals", ",", " ", "coords"}], "}"}]}]}], "\n", "  ", "]"}]}], ";",
   " ", 
  RowBox[{
   RowBox[{"plotCutBoundary2d", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals_", ",", " ", "_"}], "}"}], ",", " ", "varRanges_", ",", 
     " ", "possibilities_", ",", " ", 
     RowBox[{"colors_", " ", ":", " ", 
      RowBox[{"{", 
       RowBox[{"Green", ",", " ", "White"}], "}"}]}], ",", " ", 
     RowBox[{"contourStyleT_", "\n", "    ", ":", "Thick"}]}], "]"}], " ", ":=",
    "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", " ", "dr", ",", " ", "names", ",", " ", "m", ",", " ", 
       "codeRules", ",", " ", "codeVals", ",", " ", "isos"}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Length", "[", "varRanges", "]"}]}], ";", "\n", "    ", 
      RowBox[{"dr", " ", "=", " ", 
       RowBox[{"varRanges", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"names", " ", "=", " ", 
       RowBox[{"varRanges", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"m", " ", "=", " ", 
       RowBox[{"Length", "[", "possibilities", "]"}]}], ";", "\n", "    ", 
      RowBox[{"codeRules", " ", "=", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"possibilities", " ", "->", " ", 
         RowBox[{"Range", "[", "m", "]"}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"codeVals", " ", "=", " ", 
       RowBox[{"vals", " ", "/.", " ", "codeRules"}]}], ";", "\n", "    ", 
      RowBox[{"isos", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"1.5", ",", " ", "m", ",", " ", "1"}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"Switch", "[", 
       RowBox[{"n", ",", "\n", "      ", "2", ",", "\n", "        ", 
        RowBox[{
         RowBox[{"codeVals", " ", "=", " ", 
          RowBox[{"Transpose", "[", 
           RowBox[{"codeVals", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}]}], ";", "\n", 
         "        ", 
         RowBox[{"ListContourPlot", "[", 
          RowBox[{"codeVals", ",", " ", 
           RowBox[{"Contours", " ", "->", " ", "isos"}], ",", " ", 
           RowBox[{"ContourStyle", " ", "->", " ", "contourStyleT"}], ",", 
           " ", 
           RowBox[{"DataRange", " ", "->", " ", "dr"}], ",", " ", 
           RowBox[{"Frame", "\n", "           ", "->", " ", "True"}], ",", 
           " ", 
           RowBox[{"FrameLabel", " ", "->", " ", "names"}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}], ",", 
           " ", 
           RowBox[{"Mesh", " ", "->", " ", "None"}], ",", " ", 
           RowBox[{
           "ContourShading", "\n", "           ", "->", " ", "colors"}], ",", 
           " ", 
           RowBox[{"PlotLegends", " ", "->", " ", "None"}]}], "]"}]}], "\n", 
        "      ", ",", "\n", "      ", "_", ",", "\n", "        ", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"PlotCutBoundary", "::", "dims"}], ",", " ", "n"}], "]"}], 
         ";", "\n", "        ", "$Failed"}]}], "\n", "    ", "]"}]}]}], "\n", 
    "  ", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9610108311243553`*^9, 3.961010832923871*^9}, {
  3.961444693584978*^9, 3.9614447673694153`*^9}, {3.964751251044873*^9, 
  3.964751274293236*^9}, {3.985890861665846*^9, 3.985891013619046*^9}, {
  3.9858910641275597`*^9, 3.985891152620513*^9}, {3.985897369283935*^9, 
  3.985897433467112*^9}},
 CellLabel->
  "In[72]:=",ExpressionUUID->"f7cf03ec-817e-402c-a0f1-ba5f048eb28e"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["IV curves", "Section",
 CellChangeTimes->{{3.963590740558733*^9, 3.963590769660226*^9}, 
   3.96775280590378*^9, {3.98148762675395*^9, 
   3.981487629857718*^9}},ExpressionUUID->"286fdbb3-db0a-4476-8ef6-\
153daa27fd8d"],

Cell[TextData[{
 "Computes the current-voltage curve that underlies the model\
\[CloseCurlyQuote]s bistability. Shows how coactive depolarizing (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalG]", "NMDA"], TraditionalForm]],
  ExpressionUUID->"84fd4fe5-a6ed-4294-af7f-45aab66053ef"],
 ") and hyperpolarizing (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalG]", "GIRK"], TraditionalForm]],
  ExpressionUUID->"94fb74b1-0703-4e1b-82b0-b6bbea86f6f8"],
 ") conductances shape the fixed-point structure of a dendritic segment."
}], "Text",
 CellChangeTimes->{{3.985835062902773*^9, 3.985835067454625*^9}, {
  3.985886825419099*^9, 
  3.9858868337483873`*^9}},ExpressionUUID->"a7fd6bb2-00cf-4a89-8d09-\
0dd4ccad497f"],

Cell[CellGroupData[{

Cell["Fig. 2 IV curves", "Subsection",
 CellChangeTimes->{{3.981499047033594*^9, 3.981499052423729*^9}, {
  3.981499151023568*^9, 
  3.9814991520593233`*^9}},ExpressionUUID->"23a96e2d-4e7a-4f9e-93aa-\
ca65ad6b9db9"],

Cell[TextData[{
 " Shows how NMDA and GIRK conductances together make a segment bistable, \
with stable rest and plateau states separated by threshold. Also compares the \
sigmoidal channel model with the cubic approximation used to analyze front \
propagation.\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     SubscriptBox["\[ScriptCapitalG]", "NMDA"],
     TraditionalForm], "=", 
    RowBox[{
     FractionBox["3", "5"], 
     SubscriptBox["\[ScriptCapitalG]", "c"]}]}], TraditionalForm]],
  ExpressionUUID->"beba4722-3f77-4a3a-a73a-a5995c30b0bd"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     SubscriptBox["\[ScriptCapitalG]", "GIRK"],
     TraditionalForm], "=", 
    RowBox[{
     FractionBox["7", "5"], 
     SubscriptBox["\[ScriptCapitalG]", "c"]}]}], TraditionalForm]],
  ExpressionUUID->"35a2d3b2-2e31-4afa-b20f-64b759c12959"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SubscriptBox["\[CapitalDelta]\[ScriptCapitalG]", "c"], 
     RowBox[{"2", 
      SubscriptBox["\[ScriptCapitalG]", "c"]}]], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["\[ScriptCapitalG]", "NMDA"], "-", 
       SubscriptBox["\[ScriptCapitalG]", "GIRK"]}], 
      RowBox[{
       SubscriptBox["\[ScriptCapitalG]", "NMDA"], "+", 
       SubscriptBox["\[ScriptCapitalG]", "GIRK"]}]], "=", 
     RowBox[{"-", "0.4"}]}]}], TraditionalForm]],ExpressionUUID->
  "3cfb0281-7610-4273-99e7-433128ca12d3"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalG]", "NMDA"], "=", 
    RowBox[{
     FractionBox["3", "7"], 
     SubscriptBox["\[ScriptCapitalG]", "GIRK"]}]}], TraditionalForm]],
  ExpressionUUID->"e5f79ae0-6e52-4ed8-ace4-ce7256a9d4ed"],
 ". Plotted below with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalG]", "c"], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"d5cf09e2-8cf3-4101-9f60-05c15a348253"],
 "."
}], "Text",
 CellChangeTimes->{{3.981497934100109*^9, 3.981498076549507*^9}, {
  3.981498108403788*^9, 3.9814981932786922`*^9}, {3.98149883278481*^9, 
  3.981498892098166*^9}, {3.9815002987396193`*^9, 3.981500325517652*^9}, {
  3.985872439283122*^9, 
  3.9858724458269043`*^9}},ExpressionUUID->"21c38102-5b85-49bb-8421-\
3b7c493998cb"],

Cell[CellGroupData[{

Cell[TextData[{
 "Fig. 2A",
 StyleBox["i",
  FontSlant->"Italic"]
