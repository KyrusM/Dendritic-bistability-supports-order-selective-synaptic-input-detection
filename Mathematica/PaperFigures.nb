Cell[CellGroupData[{

Cell["Converting to micrometers", \
"Subsection",ExpressionUUID->"d96c2148-f8ae-47e4-b70c-7bd1fc65a2b2"],

Cell["The conductance and spacing sweeps run in Figure7/run.py.", \
"Text",ExpressionUUID->"e9fdb945-6fe4-4b11-8957-e7bb0efa3ddb"],

Cell[CellGroupData[{

Cell["Figure formatting", \
"Subsubsection",ExpressionUUID->"04b18d82-07e2-4d70-b757-dad6775bbeb5"],

Cell["\<\
PlotFigure7 loads the Python minimum-spacing projections and saves the \
combined panels. majorX, majorA and majorR select labeled ticks; tickLength, \
xMarks and yMarks draw them. rgb, lineParts and fillParts color and draw the \
curves and their projections.\
\>", "Text",ExpressionUUID->"f31ccd4e-d440-4337-a8c2-9be5d5a9f436"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PlotFigure7", "[", 
    RowBox[{"folder_", ",", " ", 
     RowBox[{"directory_", ":", "\"\<results\>\""}]}], "]"}], " ", ":=", "\n",
    "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", " ", "root", ",", " ", 
       RowBox[{"w1", " ", "=", " ", "150"}], ",", " ", 
       RowBox[{"w2", " ", "=", " ", "75"}], ",", " ", 
       RowBox[{"ht", " ", "=", " ", "100"}], ",", " ", 
       RowBox[{"imagePadding", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"15", ",", " ", "5"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"15", ",", " ", "4"}], "}"}]}], "}"}]}], ",", " ", 
       "aRange", ",", " ", "majorLength", ",", "\n", "     ", "minorLength", ",",
        " ", "aValues", ",", " ", "majorX", ",", " ", "majorA", ",", " ", 
       "majorR", ",", " ", "spacingPadding", ",", " ", "tickLength", ",", " ",
        "xMarks", ",", " ", "yMarks", ",", " ", "rgb", ",", " ", "lineParts", 
       ",", "\n", "     ", "fillParts", ",", " ", "panels", ",", " ", 
       "xRange", ",", " ", "rRange", ",", " ", "xValues", ",", " ", "rValues",
        ",", " ", "ticksBase", ",", " ", "ticksBaseSlnt", ",", " ", 
       "ticksBaseY", ",", " ", "ticksBaseYSilent", ",", "\n", "     ", 
       "ticksR", ",", " ", "ticksRTop", ",", " ", "ticksMain", ",", " ", 
       "ticksLeft", ",", " ", "ticksTop", ",", " ", "curves", ",", " ", 
       "mainLines", ",", " ", "leftLines", ",", " ", "leftFill", ",", " ", 
       "topLines", ",", "\n", "     ", "topFill", ",", " ", "hairlines", ",", 
       " ", "dualMain", ",", " ", "dualTop", ",", " ", "color", ",", " ", 
       "alpha", ",", " ", "p1", ",", " ", "p2", ",", " ", "pTop", ",", " ", 
       "group"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"root", " ", "=", " ", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"folder", ",", " ", "\"\<plots\>\""}], "}"}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"DirectoryQ", "[", "root", "]"}]}], ",", "\n", "      ", 
        RowBox[{"CreateDirectory", "[", "root", "]"}]}], "\n", "    ", "]"}], 
      ";", "\n", "    ", 
      RowBox[{"data", " ", "=", " ", 
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "folder", ",", " ", "directory", ",", 
            " ", "\"\<projections.json\>\""}], "}"}], "]"}], ",", 
         " ", "\"\<RawJSON\>\""}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"aRange", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1.4"}], "}"}]}], ";", "\n", "    ", 
      RowBox[{"majorLength", " ", "=", " ", "2.4"}], ";", "\n", "    ", 
      RowBox[{"minorLength", " ", "=", " ", ".8"}], ";", "\n", "    ", 
      RowBox[{"aValues", " ", "=", " ", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "14"}], "]"}], " ", "/", " ", "10"}]}], ";", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"majorX", "[", "v_", "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"v", ",", " ", "5"}], "]"}], " ", "==", " ", "0"}]}], ";", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"majorA", "[", "v_", "]"}], " ", ":=", " ", 
       RowBox[{"IntegerQ", "[", "v", "]"}]}], ";", "\n", "    ", 
      RowBox[{
       RowBox[{"majorR", "[", "v_", "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"10", " ", "*", " ", "v"}], ",", " ", "4"}], "]"}], " ", "==",
         " ", "0"}]}], ";", "\n", "    ", 
      RowBox[{"spacingPadding", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"21", ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"15", ",", " ", "4"}], "}"}]}], "}"}]}], ";", "\n", "    ", 
      
      RowBox[{
       RowBox[{"tickLength", "[", "major_", "]"}], " ", ":=", "\n", "      ", 
       
       RowBox[{"If", "[", 
        RowBox[{
        "major", ",", "\n", "        ", "majorLength", "\n", "        ", ",", 
         "\n", "        ", "minorLength"}], "\n", "      ", "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"xMarks", "[", 
        RowBox[{"values_", ",", " ", "major_", ",", " ", "y_"}], "]"}], " ", ":=",
        " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"v", ",", " ", "y"}], "}"}], ",", " ", 
            RowBox[{"Offset", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", " ", 
                RowBox[{"tickLength", "[", 
                 RowBox[{"major", "[", "v", "]"}], "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"v", ",", " ", "y"}], "}"}]}], "]"}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"{", "\n", "      ", 
          RowBox[{"v", ",", " ", "values"}], "}"}]}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{
       RowBox[{"yMarks", "[", 
        RowBox[{"values_", ",", " ", "major_", ",", " ", "x_"}], "]"}], " ", ":=",
        " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "v"}], "}"}], ",", " ", 
            RowBox[{"Offset", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"tickLength", "[", 
                 RowBox[{"major", "[", "v", "]"}], "]"}], ",", " ", "0"}], 
               "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"x", ",", " ", "v"}], "}"}]}], "]"}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"{", "\n", "      ", 
          RowBox[{"v", ",", " ", "values"}], "}"}]}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{
       RowBox[{"rgb", "[", "q_", "]"}], " ", ":=", " ", 
       RowBox[{"RGBColor", " ", "@@", " ", "q"}]}], ";", "\n", "    ", 
      RowBox[{
       RowBox[{"lineParts", "[", "parts_", "]"}], " ", ":=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Line", " ", "/@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"parts", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], " ", ">", " ", "1"}], 
             "&"}]}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"AbsolutePointSize", "[", "1.5", "]"}], ",", " ", 
              RowBox[{"Point", "[", "\n", "      ", 
               RowBox[{"First", "[", "#", "]"}], "]"}]}], "}"}], "&"}], ")"}],
           " ", "/@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"parts", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "1"}], 
             "&"}]}], "]"}]}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{
       RowBox[{"fillParts", "[", "polys_", "]"}], " ", ":=", "\n", "      ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"polys", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", "\n", "        ", 
         RowBox[{"{", "}"}], "\n", "        ", ",", "\n", "        ", 
         RowBox[{"FilledCurve", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Line", "[", 
               RowBox[{"Append", "[", 
                RowBox[{"#", ",", " ", 
                 RowBox[{"First", "[", "#", "]"}]}], "]"}], "]"}], "}"}], 
             "&"}], ")"}], " ", "/@", " ", "polys"}], "]"}]}], "\n", "      ",
         "]"}]}], ";", "\n", "    ", 
      RowBox[{"panels", " ", "=", " ", 
       RowBox[{"<|", "|>"}]}], ";", "\n", "    ", 
      RowBox[{"Do", "[", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"xRange", " ", "=", " ", 
          RowBox[{
           RowBox[{"data", "[", "\"\<x_ranges\>\"", "]"}], "[", "placement", 
           "]"}]}], ";", "\n", "      ", 
         RowBox[{"rRange", " ", "=", " ", 
          RowBox[{
           RowBox[{"data", "[", "\"\<displayed_r_range\>\"", "]"}], "[", 
           "placement", "]"}]}], ";", "\n", "      ", 
         RowBox[{"xValues", " ", "=", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"Floor", "[", 
             RowBox[{"xRange", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
         "      ", 
         RowBox[{"rValues", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"-", "10"}], ",", " ", "10"}], "]"}], " ", "/", " ", 
             "10"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"rRange", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "<=", " ", "#", " ", "<=",
               " ", 
              RowBox[{"rRange", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", 
         "      ", 
         RowBox[{"ticksBase", " ", "=", "\n", "        ", 
          RowBox[{"Table", "[", "\n", "          ", 
           RowBox[{
            RowBox[{"{", "\n", "            ", 
             RowBox[{"v", "\n", "            ", ",", "\n", "            ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"placement", " ", "==", " ", "\"\<head\>\""}], ",", 
                  "\n", "              ", 
                  RowBox[{
                   RowBox[{"Mod", "[", 
                    RowBox[{"v", ",", " ", "10"}], "]"}], " ", "==", " ", 
                   "0"}], "\n", "              ", ",", "\n", "              ", 
                  RowBox[{"majorX", "[", "v", "]"}]}], "\n", "            ", 
                 "]"}], ",", "\n", "              ", "v", "\n", 
                "              ", ",", "\n", "              ", "\"\<\>\""}], 
               "\n", "            ", "]"}], "\n", "            ", ",", "\n", 
              "            ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0"}], "}"}]}], "\n", "          ", 
             "}"}], "\n", "          ", ",", "\n", "          ", 
            RowBox[{"{", 
             RowBox[{"v", ",", " ", "xValues"}], "}"}]}], "\n", "        ", 
           "]"}]}], ";", "\n", "      ", 
         RowBox[{"ticksBaseSlnt", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<\>\"", ",", 
               " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "&"}], ")"}], 
           " ", "/@", " ", "ticksBase"}]}], ";", "\n", "      ", 
         RowBox[{"ticksBaseY", " ", "=", "\n", "        ", 
          RowBox[{"Table", "[", "\n", "          ", 
           RowBox[{
            RowBox[{"{", "\n", "            ", 
             RowBox[{"v", "\n", "            ", ",", "\n", "            ", 
