Cell[BoxData[
 RowBox[{"savePanels", "[", 
  RowBox[{
   RowBox[{"{", "\"\<Fig5Civ.svg\>\"", "}"}], ",", 
   RowBox[{
    RowBox[{"repval", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[ScriptR]", "\[Rule]", 
        RowBox[{"-", "0.6`"}]}], ",", 
       RowBox[{"\[CapitalDelta]x", "\[Rule]", 
        RowBox[{"3.5`", " ", "\[ScriptL]"}]}], ",", 
       RowBox[{
        SubscriptBox["G", "AMPA"], "\[Rule]", 
        RowBox[{"3", " ", 
         SubscriptBox["G", "c"]}]}], ",", 
       RowBox[{"\[Tau]A", "\[Rule]", "2"}], ",", 
       RowBox[{"\[Tau]", "\[Rule]", "1"}]}], "}"}]}], ";", "Null", ";", 
