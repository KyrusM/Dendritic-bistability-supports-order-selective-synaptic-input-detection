          RowBox[{"(", 
           RowBox[{"-", "7"}], ")"}], " ", 
          RowBox[{
           SubscriptBox["f", "GIRK"], "[", 
           RowBox[{"mVto", "[", 
            RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", 
          RowBox[{"-", "100"}], ",", "10"}], "}"}], ",", 
        RowBox[{"AspectRatio", "\[Rule]", 
