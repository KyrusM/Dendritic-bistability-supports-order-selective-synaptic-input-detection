          RowBox[{"pair", ",", " ", "vcPairs"}], "}"}]}], "\n", "      ", 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"tol", " ", "=", " ", "0.1"}], ";", "\n", "    ", 
