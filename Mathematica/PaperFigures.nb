Cell[CellGroupData[{

Cell["Counting stable points", "Section",
 CellChangeTimes->{{3.981606312079218*^9, 
  3.981606315930949*^9}},ExpressionUUID->"f9f3f27f-5758-461c-86a8-\
9adfb8e6c5b1"],

Cell["\<\
countStable counts distinct stable states reached from different initial \
voltages in the two segments. solveOnce evolves one voltage pair after \
release from clamping; uinit sets the surrounding voltage profile.\
\>", "Text",ExpressionUUID->"7aa92e43-fc18-4203-9032-7559c00380ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"countStable", "[", 
    RowBox[{"repval_", ",", " ", "m_", ",", " ", 
     RowBox[{"offset_", " ", ":", " ", 
      RowBox[{
       RowBox[{"-", "0.5"}], " ", "*", " ", "\[CapitalDelta]x"}]}]}], "]"}], 
   " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nN", ",", " ", "nm", ",", " ", "xs", ",", " ", "vars", ",", " ", 
       "uinit", ",", " ", "eqs", ",", " ", "tlim", ",", " ", "holdTime", ",", 
       " ", "solveOnce", ",", " ", "vcPairs", ",", " ", "results", ",", " ", 
       "uniq", ",", " ", "tol"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"nN", " ", "=", "\n", "      ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[CapitalDelta]x", " ", "/", " ", "\[ScriptL]"}], 
              ")"}], " ", "^", " ", "2"}], " ", "//.", " ", "repval"}], ")"}],
           " ", ">", " ", "4"}], ",", "\n", "        ", "10", "\n", 
         "        ", ",", "\n", "        ", "20"}], "\n", "      ", "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"nm", " ", "=", " ", 
       RowBox[{
        RowBox[{"nN", " ", "*", " ", "m"}], " ", "+", " ", 
        RowBox[{"Floor", "[", 
         RowBox[{"m", " ", "/", " ", "2"}], "]"}]}]}], ";", "\n", "    ", 
      RowBox[{"xs", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "nm"}], ",", " ", "nm"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"vars", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"-", "nm"}], ",", " ", "nm"}], "}"}]}], "]"}]}], ";", "\n",
       "    ", 
      RowBox[{
       RowBox[{"uinit", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"-", 
        RowBox[{"Tanh", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", " ", "+", " ", "offset"}], ")"}], " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"2", " ", "*", " ", "\[ScriptL]"}], ")"}]}], "]"}]}]}], ";",
       "\n", "    ", 
      RowBox[{"tlim", " ", "=", " ", "50"}], ";", "\n", "    ", 
      RowBox[{"holdTime", " ", "=", " ", 
       RowBox[{"tlim", " ", "/", " ", "2"}]}], ";", "\n", "    ", 
      RowBox[{"eqs", " ", "=", "\n", "      ", 
       RowBox[{"Table", "[", "\n", "        ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Tau]", " ", "*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "1", "]"}], "[", 
             RowBox[{"u", "[", "i", "]"}], "]"}], "[", "t", "]"}]}], " ", "==",
           "\n", "          ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{"i", ",", " ", "m"}], "]"}], " ", "==", " ", "0"}], ",",
              "\n", "              ", 
             RowBox[{"UnitStep", "[", 
              RowBox[{"t", " ", "-", " ", "holdTime"}], "]"}], "\n", 
             "              ", ",", "\n", "              ", "1"}], "\n", 
            "            ", "]"}], " ", "*", "\n", "            ", 
           RowBox[{"(", "\n", "              ", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"i", ",", " ", "m"}], "]"}], " ", "==", " ", "0"}], ",",
                "\n", "                  ", 
               RowBox[{"m", " ", "*", " ", 
                RowBox[{"(", 
                 RowBox[{"1", " ", "+", " ", "\[ScriptR]"}], ")"}], " ", "*", 
                " ", 
                RowBox[{
                 RowBox[{"Subscript", "[", 
                  RowBox[{"f", ",", " ", "NMDA"}], "]"}], "[", 
                 RowBox[{
                  RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}], "]"}]}], 
               "\n", "                  ", ",", "\n", "                  ", 
               "0"}], "\n", "                ", "]"}], " ", "+", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", "\[ScriptR]"}], ")"}], " ", "*", 
              " ", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"f", ",", " ", "GIRK"}], "]"}], "[", 
               RowBox[{
                RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}], "]"}]}], " ", "+",
              "\n", "                ", 
             RowBox[{
              RowBox[{"m", "^", "2"}], " ", "*", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"\[ScriptL]", " ", "/", " ", "\[CapitalDelta]x"}], 
                ")"}], " ", "^", " ", "2"}], " ", "*", "\n", 
              "                  ", 
              RowBox[{"(", "\n", "                    ", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"i", " ", "<", " ", "nm"}], ",", "\n", 
                  "                        ", 
                  RowBox[{
                   RowBox[{"u", "[", 
                    RowBox[{"i", " ", "+", " ", "1"}], "]"}], "[", "t", "]"}],
                   "\n", "                        ", ",", "\n", 
                  "                        ", 
                  RowBox[{
                   RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}]}], "\n", 
                 "                      ", "]"}], " ", "+", "\n", 
                "                      ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"i", " ", ">", " ", 
                   RowBox[{"-", "nm"}]}], ",", "\n", 
                  "                        ", 
                  RowBox[{
                   RowBox[{"u", "[", 
                    RowBox[{"i", " ", "-", " ", "1"}], "]"}], "[", "t", "]"}],
                   "\n", "                        ", ",", "\n", 
                  "                        ", 
                  RowBox[{
                   RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}]}], "\n", 
                 "                      ", "]"}], " ", "-", " ", 
                RowBox[{"2", " ", "*", " ", 
                 RowBox[{
                  RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}]}]}], "\n", 
               "                  ", ")"}]}]}], "\n", "            ", 
            ")"}]}]}], "\n", "        ", ",", "\n", "        ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"-", "nm"}], ",", " ", "nm"}], "}"}]}], "\n", "      ", 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{
       RowBox[{"solveOnce", "[", 
        RowBox[{"{", 
         RowBox[{"vc1_", ",", " ", "vc2_"}], "}"}], "]"}], " ", ":=", "\n", 
       "      ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "ndsol", "}"}], ",", "\n", "        ", 
         RowBox[{
          RowBox[{"ndsol", " ", "=", "\n", "          ", 
           RowBox[{"NDSolve", "[", "\n", "            ", 
            RowBox[{
             RowBox[{
              RowBox[{"Flatten", "[", "\n", "                ", 
               RowBox[{"{", "\n", "                  ", 
                RowBox[{
                "eqs", "\n", "                  ", ",", "\n", 
                 "                  ", 
                 RowBox[{"Table", "[", "\n", "                    ", 
                  RowBox[{
                   RowBox[{"Switch", "[", 
                    RowBox[{
                    "i", ",", "\n", "                      ", "m", ",", "\n", 
                    "                        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"u", "[", "i", "]"}], "[", 
                    RowBox[{"-", "20"}], "]"}], " ", "==", " ", "vc1"}], "\n",
                     "                      ", ",", "\n", 
                    "                      ", 
                    RowBox[{"2", " ", "*", " ", "m"}], ",", "\n", 
                    "                        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"u", "[", "i", "]"}], "[", 
                    RowBox[{"-", "20"}], "]"}], " ", "==", " ", "vc2"}], "\n",
                     "                      ", ",", "\n", 
                    "                      ", "_", ",", "\n", 
                    "                        ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"u", "[", "i", "]"}], "[", 
                    RowBox[{"-", "20"}], "]"}], " ", "==", " ", 
                    RowBox[{"uinit", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"xs", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", " ", "+", " ", "nm", " ", "+", " ", "1"}], 
                    "]"}], "]"}], " ", "*", " ", "\[CapitalDelta]x"}], ")"}], 
                    " ", "/", " ", "m"}], "]"}]}]}], "\n", 
                    "                    ", "]"}], "\n", 
                   "                    ", ",", "\n", "                    ", 
                   
                   RowBox[{"{", 
                    RowBox[{"i", ",", " ", 
                    RowBox[{"-", "nm"}], ",", " ", "nm"}], "}"}]}], "\n", 
                  "                  ", "]"}]}], "\n", "                ", 
                "}"}], "\n", "              ", "]"}], " ", "//.", " ", 
              "repval"}], "\n", "            ", ",", "\n", "            ", 
             "vars", "\n", "            ", ",", "\n", "            ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", 
               RowBox[{"-", "20"}], ",", " ", "tlim"}], "}"}]}], "\n", 
            "          ", "]"}]}], ";", "\n", "        ", "ndsol"}]}], "\n", 
        "      ", "]"}]}], ";", "\n", "    ", 
      RowBox[{"vcPairs", " ", "=", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.8"}], ",", " ", "0.8"}], "}"}], ",", " ", "2"}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"results", " ", "=", "\n", "      ", 
       RowBox[{"Table", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"With", "[", 
