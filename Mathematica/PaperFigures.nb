             RowBox[{"\[CapitalDelta]x", " ", "/", " ", "\[ScriptL]"}], " ", "//.",
              " ", "repval"}], ")"}], " ", "^", " ", "2"}], " ", "<", " ", 
          "6"}], ",", "\n", "          ", "10", "\n", "        ", ",", "\n", 
         "        ", "True", ",", "\n", "          ", "5"}], "\n", "      ", 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"nm", " ", "=", " ", 
       RowBox[{
        RowBox[{"nN", " ", "*", " ", "m"}], " ", "+", " ", 
        RowBox[{"Floor", "[", 
         RowBox[{"m", " ", "/", " ", "2"}], "]"}]}]}], ";", "\n", "    ", 
      RowBox[{"xs", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "nm"}], ",", " ", "nm"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"vars", " ", "=", " ", 
