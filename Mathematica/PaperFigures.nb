Cell[CellGroupData[{

Cell["Figure formatting", \
"Subsubsection",ExpressionUUID->"6cad6b11-413d-49c5-804c-addfa962bb8b"],

Cell["\<\
SurfaceOutline draws surface perimeters. PropagationSurface formats the \
propagation boundaries. FormatSurface loads and formats each Figure 6 grid.\
\>", "Text",ExpressionUUID->"e3d5d703-ed69-4b15-aac5-88f4d7a5ab01"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SurfaceOutline", "[", 
    RowBox[{"vertices_", ",", "primitives_", ",", 
     RowBox[{"upper_", ":", "None"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"faces", ",", "edges", ",", "counts", ",", "boundary"}], "}"}], 
     ",", 
     RowBox[{
      RowBox[{"faces", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"primitives", ",", 
           RowBox[{
            RowBox[{"Polygon", "[", 
             RowBox[{"p_", ",", "___"}], "]"}], "\[RuleDelayed]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"VectorQ", "[", 
               RowBox[{"p", ",", "IntegerQ"}], "]"}], ",", 
              RowBox[{"{", "p", "}"}], ",", "p"}], "]"}]}], ",", 
           "\[Infinity]"}], "]"}], ",", "1"}], "]"}]}], ";", 
      RowBox[{"edges", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Partition", "[", 
             RowBox[{
              RowBox[{"Append", "[", 
               RowBox[{"#1", ",", 
                RowBox[{"First", "[", "#1", "]"}]}], "]"}], ",", "2", ",", 
              "1"}], "]"}], "&"}], ")"}], "/@", "faces"}], ",", "1"}], 
        "]"}]}], ";", 
      RowBox[{"counts", "=", 
       RowBox[{"Counts", "[", 
        RowBox[{"Sort", "/@", "edges"}], "]"}]}], ";", 
      RowBox[{"boundary", "=", 
       RowBox[{"Keys", "[", 
        RowBox[{"Select", "[", 
         RowBox[{"counts", ",", 
          RowBox[{
           RowBox[{"#1", "\[Equal]", "1"}], "&"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"upper", "=!=", "None"}], ",", 
        RowBox[{"boundary", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"boundary", ",", 
           RowBox[{"Function", "[", 
            RowBox[{"edge", ",", 
             RowBox[{"!", 
              RowBox[{"And", "@@", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"vertices", "\[LeftDoubleBracket]", 
                    RowBox[{"#1", ",", "3"}], "\[RightDoubleBracket]"}], "-", 
                    "upper"}], "]"}], "<", 
                   FractionBox["1", 
                    SuperscriptBox["10", "9"]]}], "&"}], ")"}], "/@", 
                "edge"}]}]}]}], "]"}]}], "]"}]}]}], "]"}], ";", 
      RowBox[{"{", 
       RowBox[{"Black", ",", 
        RowBox[{"Opacity", "[", "1", "]"}], ",", 
        RowBox[{"AbsoluteThickness", "[", "0.6`", "]"}], ",", 
        RowBox[{"Line", "[", "boundary", "]"}]}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"PropagationSurface", "[", "data_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bounds", "=", 
        RowBox[{"data", "[", "\"\<bounds\>\"", "]"}]}], ",", "values", ",", 
       "graphs", ",", "g", ",", "top", ",", "topLines", ",", "contour", ",", 
       "field", ",", "lines", ",", "rmin", ",", "rmax", ",", "xmax", ",", 
       "zmax", ",", "gridX", ",", "grid", ",", "secondary", ",", "physical", ",",
        "label", ",", "xTicks", ",", "rTicks", ",", "zTicks", ",", "boxLines",
        ",", "marks", ",", 
       RowBox[{"conversion", "=", "0.23059782865759065`"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
