Cell[CellGroupData[{

Cell[TextData[{
 "Fig. 2C",
 StyleBox["ii",
  FontSlant->"Italic"]
}], "Subsubsection",
 CellChangeTimes->{{3.981508021487767*^9, 3.981508023315263*^9}, {
  3.9858346302614603`*^9, 
  3.985834630676523*^9}},ExpressionUUID->"25d8278d-00a5-4475-941c-\
bdf28429108b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"savePanels", "[", 
  RowBox[{
   RowBox[{"{", "\"\<Fig2Cii.png\>\"", "}"}], ",", 
   RowBox[{
    RowBox[{"repval", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[ScriptR]", "\[Rule]", 
        FractionBox[
         RowBox[{
          SubscriptBox["G", "NMDA"], "-", 
          SubscriptBox["G", "GIRK"]}], 
         RowBox[{
          SubscriptBox["G", "NMDA"], "+", 
          SubscriptBox["G", "GIRK"]}]]}], "/.", "\[VeryThinSpace]", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["G", "NMDA"], "\[Rule]", 
         RowBox[{"1", " ", 
          SubscriptBox["G", "GIRK"]}]}], "}"}]}], "}"}]}], ";", "Null", ";", 
    RowBox[{
     RowBox[{"uinit", "[", "x_", "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"Tanh", "[", 
       FractionBox[
        RowBox[{"x", "-", "0.5`"}], 
        RowBox[{"2", " ", "\[ScriptL]"}]], "]"}]}]}], ";", "Null", ";", 
    RowBox[{"diffeq", "=", 
     RowBox[{"Hold", "[", 
      RowBox[{
       RowBox[{"\[Tau]", " ", 
        RowBox[{
         SubscriptBox["\[PartialD]", "t"], 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[ScriptF]", "[", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], "]"}], "+", 
        RowBox[{
         SuperscriptBox["\[ScriptL]", "2"], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}]}]}], "]"}]}], ";", "Null", ";", 
    
    RowBox[{"ndsol", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ReleaseHold", "[", "diffeq", "]"}], ",", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"x", ",", 
              RowBox[{"-", "20"}]}], "]"}], "\[Equal]", 
            RowBox[{"uinit", "[", "x", "]"}]}], ",", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{
              RowBox[{"-", "30"}], ",", "t"}], "]"}], "\[Equal]", "1"}], ",", 
           
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"30", ",", "t"}], "]"}], "\[Equal]", 
            RowBox[{"-", "1"}]}]}], "}"}], "/.", "\[VeryThinSpace]", 
         "repval"}], "/.", "\[VeryThinSpace]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[ScriptL]", "\[Rule]", "1"}], ",", 
          RowBox[{"\[Tau]", "\[Rule]", "1"}]}], "}"}]}], ",", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "30"}], ",", "30"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "20"}], ",", "160"}], "}"}], ",", 
       RowBox[{"MaxStepSize", "\[Rule]", "0.01`"}]}], "]"}]}], ";", "Null", ";", 
    RowBox[{"Show", "[", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], "/.", "\[VeryThinSpace]", "ndsol"}],
         "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "15"}], ",", "15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "160"}], "}"}], ",", 
       RowBox[{"AxesLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<\>\"", ",", "\"\<\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
       RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", 
       RowBox[{"Mesh", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"-", "15"}], ",", "15", ",", "5"}], "]"}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "160", ",", "20"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"ViewPoint", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "2"}], ",", "1"}], "}"}]}], ",", 
       RowBox[{"ViewVertical", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ",", 
       RowBox[{"Ticks", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#1", ",", "\"\<\>\""}], "}"}], "&"}], ")"}], "/@", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"-", "5"}], ",", 
               RowBox[{"-", "15"}], ",", 
               RowBox[{"-", "5"}]}], "]"}], ",", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", "15", ",", "5"}], "]"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#1", ",", "\"\<\>\""}], "}"}], "&"}], ")"}], "/@", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", "160", ",", "20"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "\"\<\>\""}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "\"\<\>\""}], "}"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "200"}], ",", 
       RowBox[{"AxesEdge", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}]}], "]"}], "]"}]}]}], 
  "]"}]], "Input",
