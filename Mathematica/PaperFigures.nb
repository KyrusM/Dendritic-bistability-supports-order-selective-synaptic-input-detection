Cell["\<\
checkDriftSigSpine classifies front drift with explicit spine heads and neck \
resistance. kirOnDen selects shaft or head GIRK channels; uinit and uinith \
set the initial shaft and head voltages.\
\>", "Text",ExpressionUUID->"21530bc2-95a5-44e0-9b61-4f6c678ce6a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkDriftSigSpine", "[", 
    RowBox[{"repval_", ",", " ", "kirOnDen_", ",", " ", "m_", ",", " ", 
     RowBox[{"offset_", " ", ":", " ", 
      RowBox[{
       RowBox[{"-", "0.5"}], " ", "*", " ", "\[CapitalDelta]x"}]}]}], "]"}], 
   " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nN", ",", " ", "nm", ",", " ", "xs", ",", " ", "vars", ",", " ", 
