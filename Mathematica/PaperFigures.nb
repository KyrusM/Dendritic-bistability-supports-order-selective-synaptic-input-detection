              RowBox[{"#1", ",", "0"}], "}"}], "]"}]}], "}"}], "]"}], "&"}], 
        ")"}], "/@", 
       RowBox[{"roots", "\[LeftDoubleBracket]", 
        RowBox[{"2", ";;", "All", ";;", "2"}], "\[RightDoubleBracket]"}]}]}], 
     "]"}]}]}], "]"}]], "Input",
