Cell["AMPA channel current per unit conductance", "Subsubsection",
 CellChangeTimes->{{3.903021591948151*^9, 3.903021624440539*^9}, 
   3.903021681306192*^9, {3.903023008205669*^9, 3.903023078619598*^9}, {
   3.9030235621610813`*^9, 3.9030235621991796`*^9}, {3.9612512038533764`*^9, 
   3.961251229166601*^9}, {3.981506096740306*^9, 3.981506108532331*^9}, {
