Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"savePanels", "[", 
  RowBox[{
   RowBox[{"{", "\"\<Fig2Bi.png\>\"", "}"}], ",", 
   RowBox[{
    RowBox[{"repval", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[ScriptR]", "\[Rule]", 
         FractionBox[
          RowBox[{
           SubscriptBox["G", "NMDA"], "-", 
           SubscriptBox["G", "GIRK"]}], 
          RowBox[{
           SubscriptBox["G", "NMDA"], "+", 
           SubscriptBox["G", "GIRK"]}]]}], "/.", "\[VeryThinSpace]", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["G", "NMDA"], "\[Rule]", 
          RowBox[{"1", " ", 
           SubscriptBox["G", "GIRK"]}]}], "}"}]}], ",", 
       RowBox[{
        SubscriptBox["G", "AMPA"], "\[Rule]", 
        RowBox[{"25", " ", 
         SubscriptBox["\[ScriptCapitalG]", "c"], " ", "\[ScriptL]"}]}], ",", 
       RowBox[{"\[Tau]A", "\[Rule]", "2"}], ",", 
       RowBox[{"\[Tau]", "\[Rule]", "1"}], ",", 
       RowBox[{"\[ScriptL]", "\[Rule]", "1"}]}], "}"}]}], ";", "Null", ";", 
    RowBox[{
     RowBox[{"uinit", "[", "x_", "]"}], ":=", 
     RowBox[{"-", "1"}]}], ";", "Null", ";", 
    RowBox[{"diffeq", "=", 
     RowBox[{"Hold", "[", 
      RowBox[{
       RowBox[{"\[Tau]", " ", 
        RowBox[{
         SubscriptBox["\[PartialD]", "t"], 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[ScriptF]", "[", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], "]"}], "+", 
        RowBox[{
         SuperscriptBox["\[ScriptL]", "2"], " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "x"}]], 
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
        FractionBox[
         RowBox[{
          SubscriptBox["G", "AMPA"], " ", 
          RowBox[{
           RowBox[{"\[Delta]", "[", "0.1`", "]"}], "[", "x", "]"}], " ", 
          RowBox[{
           SubscriptBox["f", "AMPA"], "[", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"x", ",", "t"}], "]"}], ",", "t", ",", "\[Tau]A", ",", 
            "40"}], "]"}]}], 
         RowBox[{
          SubscriptBox["\[ScriptCapitalG]", "c"], " ", "\[ScriptL]"}]]}]}], 
      "]"}]}], ";", "Null", ";", 
    RowBox[{"ndsol", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ReleaseHold", "[", "diffeq", "]"}], ",", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"x", ",", 
             RowBox[{"-", "20"}]}], "]"}], "\[Equal]", 
           RowBox[{"uinit", "[", "x", "]"}]}], ",", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{
             RowBox[{"-", "30"}], ",", "t"}], "]"}], "\[Equal]", 
           RowBox[{"-", "1"}]}], ",", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"30", ",", "t"}], "]"}], "\[Equal]", 
           RowBox[{"-", "1"}]}]}], "}"}], "//.", "\[VeryThinSpace]", 
        "repval"}], ",", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "30"}], ",", "30"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"-", "20"}], ",", "160"}], "}"}], ",", 
       RowBox[{"MaxStepSize", "\[Rule]", "0.01`"}]}], "]"}]}], ";", "Null", ";", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Plot3D", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], "/.", "\[VeryThinSpace]", 
          "ndsol"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "15"}], ",", "15"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "160"}], "}"}], ",", 
        RowBox[{"AxesLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<\>\"", ",", "\"\<\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
        RowBox[{"Axes", "\[Rule]", "True"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
        RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", 
        RowBox[{"Mesh", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "30"}], ",", "30", ",", "5"}], "]"}], ",", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "0.3`"}], ",", "160", ",", "20"}], "]"}]}], "}"}]}],
         ",", 
        RowBox[{"ViewPoint", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "2"}], ",", "1"}], "}"}]}], ",", 
        RowBox[{"ViewVertical", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ",", 
        RowBox[{"Ticks", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#1", ",", "\"\<\>\""}], "}"}], "&"}], ")"}], "/@", 
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"-", "30"}], ",", "30", ",", "5"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#1", ",", "\"\<\>\""}], "}"}], "&"}], ")"}], "/@", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", "160", ",", "20"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", 
               RowBox[{"-", "90"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "200"}], ",", 
        RowBox[{"AxesEdge", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}]}], "]"}], ",", 
      RowBox[{"ListPointPlot3D", "[", 
       RowBox[{
