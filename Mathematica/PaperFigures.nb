   3.981513579015253*^9}},ExpressionUUID->"9689b7ff-283b-47fd-9786-\
86df7ff169d5"],

Cell["\<\
Multiply the AMPA alpha function by the normalized driving voltage.\
\>", "Text",ExpressionUUID->"ea8c6331-df44-4538-96ad-00509276b482"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["f", "AMPA"], "[", 
    RowBox[{"u_", ",", "t_", ",", "\[Tau]AMPA_", ",", "t0_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]", "[", "\[Tau]AMPA", "]"}], "[", 
     RowBox[{"t", "-", "t0"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "u"}], ")"}]}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9815097111459703`*^9, 3.981509811215747*^9}, {
  3.981510915408491*^9, 3.981510916325873*^9}, {3.9815173320290194`*^9, 
