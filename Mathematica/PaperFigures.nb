Cell[CellGroupData[{

Cell["Alpha function and Dirac delta approximations", "Subsubsection",
 CellChangeTimes->{{3.903021591948151*^9, 3.903021624440539*^9}, 
   3.903021681306192*^9, {3.903023008205669*^9, 3.903023078619598*^9}, {
   3.9030235621610813`*^9, 3.9030235621991796`*^9}, {3.9612512038533764`*^9, 
   3.961251229166601*^9}, {3.981506096740306*^9, 
   3.981506108532331*^9}},ExpressionUUID->"b9af2792-450f-43b9-8f2d-\
8c8f2e98ac68"],

Cell["\<\
Define a finite-width approximation to a Dirac delta and a unit-height \
rectangular input.\
\>", "Text",ExpressionUUID->"70401506-d2e8-4908-af13-b2452a4b6eeb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]", "[", "d_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"UnitStep", "[", 
       RowBox[{"(", 
        RowBox[{"#", "+", 
         FractionBox["d", "2"]}], ")"}], "]"}], "-", 
      RowBox[{"UnitStep", "[", 
       RowBox[{"(", 
        RowBox[{"#", "-", 
         FractionBox["d", "2"]}], ")"}], "]"}]}], "d"], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Iota]", "[", "d_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"UnitStep", "[", 
      RowBox[{"(", 
       RowBox[{"#", "+", 
        FractionBox["d", "2"]}], ")"}], "]"}], "-", 
     RowBox[{"UnitStep", "[", 
      RowBox[{"(", 
       RowBox[{"#", "-", 
        FractionBox["d", "2"]}], ")"}], "]"}]}], "&"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.958660093109811*^9, 3.9586601310643673`*^9}, {
   3.958700668046674*^9, 3.95870068468824*^9}, {3.9612516198780613`*^9, 
   3.9612516430835056`*^9}, {3.9612517024133472`*^9, 3.961251754863283*^9}, {
   3.961251791330902*^9, 3.961251807020035*^9}, {3.9612518727921886`*^9, 
   3.961251923615576*^9}, 3.9612519566708965`*^9, 3.9612521172650757`*^9, {
   3.9612526562108784`*^9, 3.961252663484709*^9}, {3.9815101237703447`*^9, 
   3.981510155002516*^9}, {3.985893069200223*^9, 3.985893070263289*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"9deea98a-4acb-4345-9d7a-5a1795485d4d"],

Cell["\<\
Define an AMPA alpha function with unit peak and zero activation before onset.\
\>", "Text",ExpressionUUID->"7445ebea-1632-41bf-9014-3110ae64c1fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]", "[", "\[Tau]_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"UnitStep", "[", "#", "]"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["#", "\[Tau]"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"#", "-", "\[Tau]"}], ")"}]}], "\[Tau]"]]}], ")"}]}], 
   "&"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.935063929498425*^9, 3.935063930382691*^9}, {
  3.935064157473871*^9, 3.935064187374558*^9}, {3.935069201980413*^9, 
  3.935069215288434*^9}, {3.9350692805508003`*^9, 3.935069309740006*^9}, {
  3.936725711821187*^9, 3.936725735543432*^9}, {3.937854972257429*^9, 
  3.9378549751880093`*^9}, {3.937855044206171*^9, 3.937855103798501*^9}, {
  3.937855142906375*^9, 3.937855238736535*^9}, {3.937855491205221*^9, 
  3.937855495668915*^9}, {3.937855648110697*^9, 3.937855670260294*^9}, {
  3.958662879994986*^9, 3.9586629356282682`*^9}, {3.961252513051996*^9, 
  3.961252570575493*^9}, {3.961252617586706*^9, 3.9612526985113907`*^9}, {
  3.9612527539256935`*^9, 3.9612527632524967`*^9}},
 CellLabel->
  "In[70]:=",ExpressionUUID->"23b907a8-efa6-4691-ab07-7a912f19fd1a"]
}, Open  ]],

