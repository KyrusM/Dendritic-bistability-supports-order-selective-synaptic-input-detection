Cell[CellGroupData[{

Cell["Fig. 3 IV curves: ", "Subsection",
 CellChangeTimes->{{3.981499114647097*^9, 
  3.981499157005362*^9}},ExpressionUUID->"79e9e8b8-fa2b-40e9-b41d-\
149aa4ad18e1"],

Cell[TextData[{
 "Shows how localizing conductances to discrete synaptic sites changes the \
number of stable equilibria in the boundary segments. Neighbors are assumed \
to be at plateau ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["e", "NMDA"]}], TraditionalForm]],ExpressionUUID->
  "0b884c03-56ba-4703-86cc-2c7a72e645ae"],
 ") and rest ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["e", "GIRK"]}], TraditionalForm]],ExpressionUUID->
  "6a6fbfa1-5e79-4a93-ad1d-36543c293b5c"],
 "). "
}], "Text",
 CellChangeTimes->{
  3.985835197592655*^9, {3.9858730344759483`*^9, 3.985873065021183*^9}, {
   3.985873105904965*^9, 3.985873134212634*^9}, {3.985888238812076*^9, 
   3.985888241978279*^9}, {3.9858884385056963`*^9, 3.985888521058728*^9}, {
   3.985919683937789*^9, 
   3.985919728948101*^9}},ExpressionUUID->"a5b8a670-9d63-41de-a1a2-\
62f07c79d737"],

Cell[CellGroupData[{

Cell["Helper code to plot the IV curves", "Subsubsection",
 CellChangeTimes->{{3.981514285293741*^9, 
  3.981514290295019*^9}},ExpressionUUID->"b8792789-fc8f-4f01-85b2-\
c9d8898c23f3"],

Cell["\<\
plotIVu1 plots the cubic membrane current and total current for a segment \
between resting and plateauing neighbors, marking the equilibria.\
\>", "Text",ExpressionUUID->"2bfafef4-c497-43ae-a421-8d924b35e110"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"plotIVu1", "[", "repval_", "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "roots", "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"roots", " ", "=", " ", 
       RowBox[{"SolveValues", "[", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[ScriptF]", "[", 
              RowBox[{"mVto", "[", 
               RowBox[{"u", " ", "*", " ", "mV"}], "]"}], "]"}], " ", "+", 
             " ", 
             RowBox[{
              RowBox[{"\[ScriptL]", "^", "2"}], " ", "*", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Subscript", "[", 
                   RowBox[{"e", ",", " ", "NMDA"}], "]"}], " ", "-", " ", 
                  RowBox[{"mVto", "[", 
                   RowBox[{"u", " ", "*", " ", "mV"}], "]"}]}], ")"}], " ", "/",
                 " ", 
                RowBox[{"\[CapitalDelta]x", "^", "2"}]}], ")"}]}], "\n", 
             "       ", "+", " ", 
             RowBox[{
              RowBox[{"\[ScriptL]", "^", "2"}], " ", "*", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Subscript", "[", 
                   RowBox[{"e", ",", " ", "GIRK"}], "]"}], " ", "-", " ", 
                  RowBox[{"mVto", "[", 
                   RowBox[{"u", " ", "*", " ", "mV"}], "]"}]}], ")"}], " ", "/",
                 " ", 
                RowBox[{"\[CapitalDelta]x", "^", "2"}]}], ")"}]}]}], " ", "==",
             " ", "0"}], " ", "/.", " ", "repval"}], "]"}], ",", " ", "u", ",",
          " ", "Reals"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"Evaluate", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"\[ScriptF]", "[", 
                RowBox[{"mVto", "[", 
                 RowBox[{"u", " ", "*", " ", "mV"}], "]"}], "]"}]}], " ", "/.",
               " ", "repval"}], ",", " ", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"\[ScriptF]", "[", 
                  RowBox[{"mVto", "[", 
                   RowBox[{"u", " ", "*", " ", "mV"}], "]"}], "]"}], " ", "+",
                  " ", 
                 RowBox[{
                  RowBox[{"\[ScriptL]", "^", "2"}], " ", "*", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Subscript", "[", 
                    RowBox[{"e", ",", " ", "NMDA"}], "]"}], " ", "-", " ", 
                    "\n", "      ", 
                    RowBox[{"mVto", "[", 
                    RowBox[{"u", " ", "*", " ", "mV"}], "]"}]}], ")"}], " ", "/",
                     " ", 
                    RowBox[{"\[CapitalDelta]x", "^", "2"}]}], ")"}]}], " ", "+",
                  " ", 
                 RowBox[{
                  RowBox[{"\[ScriptL]", "^", "2"}], " ", "*", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Subscript", "[", 
                    RowBox[{"e", ",", " ", "GIRK"}], "]"}], " ", "-", " ", 
                    RowBox[{"mVto", "[", 
                    RowBox[{"u", " ", "*", " ", "mV"}], "]"}]}], ")"}], " ", "/",
                     " ", 
                    RowBox[{"\[CapitalDelta]x", "^", "2"}]}], ")"}]}]}], 
                ")"}]}], " ", "/.", " ", "repval"}]}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", 
            RowBox[{"-", "100"}], ",", " ", "10"}], "\n", "      ", "}"}], ",",
           " ", 
          RowBox[{"AspectRatio", " ", "->", " ", 
           RowBox[{"1", " ", "/", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"3", "/", "2"}], ")"}], " ", "*", " ", "GoldenRatio"}],
              ")"}]}]}], ",", " ", 
          RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<current\>\"", ",", " ", "None"}], "}"}], ",", " ", 
             
             RowBox[{"{", 
              RowBox[{"\"\<\>\"", ",", " ", "None"}], "\n", "      ", "}"}]}],
             "}"}]}], ",", " ", 
          RowBox[{"FrameTicks", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "0", "}"}], ",", " ", "None"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "90"}], ",", " ", "0"}], "}"}], ",", " ", 
               "None"}], "}"}]}], "}"}]}], ",", " ", 
          RowBox[{"PlotRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "100"}], ",", " ", "10"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.35"}], ",", " ", "0.35"}], "}"}]}], "}"}]}], ",",
           " ", 
          RowBox[{"ImageSize", "\n", "       ", "->", " ", "150"}], ",", " ", 
          
          RowBox[{"PlotStyle", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"Gray", ",", " ", 
               RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}], ",", " ", 
             "Brown"}], "}"}]}], ",", " ", 
          RowBox[{"GridLines", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "1", "}"}], ",", " ", 
             RowBox[{"{", "0", "}"}]}], "}"}]}], ",", " ", 
          RowBox[{"GridLinesStyle", "\n", "       ", "->", " ", "Black"}], ",",
           " ", 
          RowBox[{"Axes", " ", "->", " ", "False"}]}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Graphics", "[", 
            RowBox[{"{", 
             RowBox[{"Brown", ",", " ", 
              RowBox[{"PointSize", "[", "0.06", "]"}], ",", " ", 
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{"#1", ",", " ", "0"}], "}"}], "]"}]}], "}"}], "]"}], 
           "&"}], ")"}], " ", "/@", " ", "roots"}], ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Graphics", "[", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{"White", ",", " ", 
              RowBox[{"PointSize", "[", "0.04", "]"}], ",", " ", 
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{"#1", ",", " ", "0"}], "}"}], "]"}]}], "}"}], "]"}], 
           "&"}], ")"}], " ", "/@", " ", 
         RowBox[{"roots", "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;", " ", "All", " ", ";;", " ", "2"}], "]"}], 
          "]"}]}]}], "]"}]}]}], "\n", "  ", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.981513809789917*^9, 3.9815138497170753`*^9}, {
  3.981513956924037*^9, 3.9815139589520283`*^9}, {3.981514206427487*^9, 
  3.981514220560438*^9}, {3.9858881807875443`*^9, 3.985888255905094*^9}},
 CellLabel->
  "In[73]:=",ExpressionUUID->"e0dc366a-326a-4e4d-b772-25213d3767b0"]
}, Closed]],

