             "ndsol"}], " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{"t", " ", "->", " ", "tlim"}], "}"}]}], ")"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "<", " ", "0"}], ",", "\n", 
