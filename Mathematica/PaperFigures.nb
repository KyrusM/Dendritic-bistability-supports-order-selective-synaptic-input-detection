            RowBox[{"{", 
             RowBox[{"t", " ", "->", " ", "tlim"}], "}"}]}], ")"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}], ",", "\n", 
        "      ", 
        RowBox[{"Return", "[", "p", "]"}]}], "\n", "    ", "]"}], ";", "\n", 
      "    ", 
      RowBox[{"rmax", " ", "=", " ", 
       RowBox[{
        RowBox[{"MaximalBy", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}], " ", "/.", 
                  " ", "ndsol"}], " ", "/.", " ", 
                 RowBox[{"{", 
                  RowBox[{"t", " ", "->", " ", "tlim"}], "}"}]}], ")"}], "[", 
               
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", 
                RowBox[{"-", "nm"}], ",", " ", "nm"}], "}"}]}], "]"}], "]"}], 
           " ", "-", " ", 
           RowBox[{"Evaluate", "[", "\n", "      ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}], " ", "/.", 
                  " ", "ndsol"}], " ", "/.", " ", 
                 RowBox[{"{", 
                  RowBox[{"t", " ", "->", " ", 
                   RowBox[{"0.75", " ", "*", " ", "tlim"}]}], "}"}]}], ")"}], 
               "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", 
                RowBox[{"-", "nm"}], ",", " ", "nm"}], "}"}]}], "]"}], 
            "]"}]}], ",", " ", "Abs"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"rmax", " ", ">", " ", "0.1"}], ",", "\n", "      ", "p", 
        "\n", "      ", ",", "\n", "      ", 
        RowBox[{"If", "[", 
