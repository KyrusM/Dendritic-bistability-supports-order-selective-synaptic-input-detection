       "uinith", ",", " ", "holdTime", ",", " ", "eqs", ",", " ", "eqsh", ",",
        " ", "tlim", ",", " ", "ndsol", ",", "\n", "     ", "rmax"}], "}"}], ",",
      "\n", "    ", 
     RowBox[{
      RowBox[{"nN", " ", "=", "\n", "      ", 
       RowBox[{"Which", "[", "\n", "        ", 
