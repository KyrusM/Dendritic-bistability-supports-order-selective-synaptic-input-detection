          RowBox[{"i", ",", " ", "spineIndices"}], "}"}]}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"uinit", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"-", 
        RowBox[{"Tanh", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", " ", "+", " ", "offset"}], ")"}], " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"2", " ", "*", " ", "\[ScriptL]"}], ")"}]}], "]"}]}]}], ";",
       "\n", "    ", 
