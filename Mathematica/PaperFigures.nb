Cell["\<\
plotIVu2Thev plots membrane and total currents for the farther segment, using \
the equivalent loads of the adjoining chains.\
\>", "Text",ExpressionUUID->"657648d1-699e-41bf-ae39-1ab70542af21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotIVu2Thev", "[", "repval_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "roots", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"roots", "=", 
