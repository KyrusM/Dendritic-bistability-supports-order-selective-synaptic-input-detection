 ", its reversal potential (Boahen 2022)."
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.8751185487823067`*^9, 3.875118740228917*^9}, {
   3.875118840049471*^9, 3.875118844455266*^9}, {3.8751722220939617`*^9, 
   3.875172244293557*^9}, {3.875172740051538*^9, 3.875172824376412*^9}, {
   3.8752088758410053`*^9, 3.875208885698885*^9}, {3.876125246377502*^9, 
   3.876125249398394*^9}, {3.8780289906321507`*^9, 3.878029285120339*^9}, 
   3.952696526410811*^9, {3.9814863383629837`*^9, 3.981486341875203*^9}, {
   3.98150630508775*^9, 3.9815063157608023`*^9}, 3.981506374893341*^9, {
   3.981506420921504*^9, 
   3.9815064555910177`*^9}},ExpressionUUID->"e22d5597-62e8-44bf-8cf6-\
03d8d6eb1050"]
}, Open  ]],

Cell["\<\
Define a sigmoid-gated current whose conductance equals one at its reversal \
potential.\
\>", "Text",ExpressionUUID->"89c7cfdb-b95c-4731-9f49-61cda43da6ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["f", "sig"], "[", 
   RowBox[{"v_", ",", "e_", ",", "vha_", ",", "vs_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{"1", "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"e", "-", "vha"}], "vs"]}]]}], 
    RowBox[{"1", "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"v", "-", "vha"}], "vs"]}]]}]], 
   RowBox[{"(", 
    RowBox[{"e", "-", "v"}], ")"}], "  "}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.903021715160542*^9, 3.9030221282831182`*^9, 3.9030222006562767`*^9, 
   3.952696526410941*^9, 3.981506385215639*^9, {3.9815064527895947`*^9, 
   3.981506460376822*^9}, 3.985963927003878*^9},
 CellLabel->
  "In[54]:=",ExpressionUUID->"096a3557-f696-42c6-b785-cfc6b3584029"]
}, Open  ]],

