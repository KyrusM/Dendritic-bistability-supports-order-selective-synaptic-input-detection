Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"savePanels", "[", 
  RowBox[{
   RowBox[{"{", "\"\<Fig2Aiii.svg\>\"", "}"}], ",", 
   RowBox[{
    RowBox[{"roots", "=", 
     RowBox[{"SolveValues", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["7", "5"], " ", 
           RowBox[{
            SubscriptBox["f", "GIRK"], "[", 
            RowBox[{"mVto", "[", 
             RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "+", 
          RowBox[{
           FractionBox["3", "5"], " ", 
           RowBox[{
            SubscriptBox["f", "NMDA"], "[", 
            RowBox[{"mVto", "[", 
             RowBox[{"u", " ", "mV"}], "]"}], "]"}]}]}], "\[Equal]", "0"}], 
        "]"}], ",", "u", ",", 
       TemplateBox[{},
        "Reals"]}], "]"}]}], ";", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            FractionBox["1", "5"], " ", 
            RowBox[{"(", 
             RowBox[{"-", "7"}], ")"}], " ", 
            RowBox[{
             SubscriptBox["f", "GIRK"], "[", 
             RowBox[{"mVto", "[", 
              RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], ",", 
           RowBox[{
            FractionBox["1", "5"], " ", 
            RowBox[{"(", 
             RowBox[{"-", "3"}], ")"}], " ", 
            RowBox[{
             SubscriptBox["f", "NMDA"], "[", 
             RowBox[{"mVto", "[", 
              RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               FractionBox["7", "5"], " ", 
               RowBox[{
                SubscriptBox["f", "GIRK"], "[", 
                RowBox[{"mVto", "[", 
                 RowBox[{"u", " ", "mV"}], "]"}], "]"}]}], "+", 
              RowBox[{
               FractionBox["3", "5"], " ", 
               RowBox[{
                SubscriptBox["f", "NMDA"], "[", 
                RowBox[{"mVto", "[", 
                 RowBox[{"u", " ", "mV"}], "]"}], "]"}]}]}], ")"}]}]}], "}"}],
          "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", 
          RowBox[{"-", "100"}], ",", "10"}], "}"}], ",", 
        RowBox[{"AspectRatio", "\[Rule]", 
         FractionBox["1", 
          FractionBox[
           RowBox[{"3", " ", "GoldenRatio"}], "2"]]}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<current\>\"", ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"None", ",", "None"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"FrameTicks", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"None", ",", "None"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "100"}], ",", "10"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.35`"}], ",", "0.35`"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "150"}], ",", 
        RowBox[{"PlotStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"RGBColor", "[", "\"\<#6580b1\>\"", "]"}], ",", 
             RowBox[{"Thickness", "[", "0.006`", "]"}]}], "]"}], ",", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"RGBColor", "[", "\"\<#ff8000\>\"", "]"}], ",", 
             RowBox[{"Thickness", "[", "0.006`", "]"}]}], "]"}], ",", 
           "Black"}], "}"}]}], ",", 
        RowBox[{"GridLines", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"{", "0", "}"}], "}"}]}], ",", 
        RowBox[{"GridLinesStyle", "\[Rule]", "Black"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
           RowBox[{"Black", ",", 
            RowBox[{"PointSize", "[", "0.06`", "]"}], ",", 
            RowBox[{"Point", "[", 
             RowBox[{"{", 
              RowBox[{"#1", ",", "0"}], "}"}], "]"}]}], "}"}], "]"}], "&"}], 
        ")"}], "/@", "roots"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
