Cell[CellGroupData[{

Cell["Channels localized to synapses", "Section",
 CellChangeTimes->{{3.9815144376290894`*^9, 
  3.981514443879311*^9}},ExpressionUUID->"2b97ae22-0ef7-4bbf-9f9b-\
c33e40b3e687"],

Cell[CellGroupData[{

Cell["Channels modeled with a cubic", "Subsection",
 CellChangeTimes->{{3.9815170327330427`*^9, 
  3.981517039267276*^9}},ExpressionUUID->"e3767bb8-bbce-4d98-bb85-\
358bdc52c821"],

Cell["\<\
Front drift and anchoring with the cubic current (Fig. 3A\[Dash]D).\
\>", "Text",
 CellChangeTimes->{{3.98589194865343*^9, 
  3.9858919809201736`*^9}},ExpressionUUID->"76168a24-4965-4a70-a62e-\
cc6ce6c1c283"],

Cell[CellGroupData[{

Cell["\<\
Simulating dendrite voltage with channels modelled with a cubic\
\>", "Subsubsection",
 CellChangeTimes->{{3.981517059430015*^9, 
  3.981517101025206*^9}},ExpressionUUID->"5b76eaf4-4611-40e3-8d5b-\
43415f38460c"],

Cell["\<\
checkDriftCubic evolves a front in the discrete cubic model and classifies it \
as advancing, retreating or anchored. Its local uinit function sets the \
initial voltage profile.\
\>", "Text",ExpressionUUID->"bad00a83-344c-4aaa-9e98-2d3824333323"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkDriftCubic", "[", 
    RowBox[{"repval_", ",", " ", 
     RowBox[{"plot_", ":", "False"}], ",", " ", 
     RowBox[{"offset_", ":", "0"}]}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nN", ",", " ", "xs", ",", " ", "vars", ",", " ", "uinit", ",", " ", 
       "eqs", ",", " ", "tlim", ",", " ", "ndsol"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"nN", " ", "=", "\n", "      ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[CapitalDelta]x", " ", "/", " ", "\[ScriptL]"}], 
              ")"}], " ", "^", " ", "2"}], " ", "//.", " ", "repval"}], ")"}],
           " ", ">", " ", "4"}], ",", "\n", "        ", "10", "\n", 
         "        ", ",", "\n", "        ", "20"}], "\n", "      ", "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"xs", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "nN"}], ",", " ", "nN"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"vars", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"-", "nN"}], ",", " ", "nN"}], "}"}]}], "]"}]}], ";", "\n",
       "    ", 
      RowBox[{
       RowBox[{"uinit", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"-", 
        RowBox[{"Tanh", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", " ", "+", " ", "offset"}], ")"}], " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"2", " ", "*", " ", "\[ScriptL]"}], ")"}]}], "]"}]}]}], ";",
       "\n", "    ", 
      RowBox[{"eqs", " ", "=", "\n", "      ", 
       RowBox[{"Table", "[", "\n", "        ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Tau]", " ", "*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "1", "]"}], "[", 
             RowBox[{"u", "[", "i", "]"}], "]"}], "[", "t", "]"}]}], " ", "==",
           "\n", "          ", 
          RowBox[{
           RowBox[{"\[ScriptF]", "[", 
            RowBox[{
             RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}], "]"}], " ", "+", 
           "\n", "            ", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[ScriptL]", " ", "/", " ", "\[CapitalDelta]x"}], 
              ")"}], " ", "^", " ", "2"}], " ", "*", "\n", "              ", 
            RowBox[{"(", "\n", "                ", 
             RowBox[{
              RowBox[{"(", "\n", "                    ", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"i", " ", "<", " ", "nN"}], ",", "\n", 
                  "                        ", 
                  RowBox[{
                   RowBox[{"u", "[", 
                    RowBox[{"i", " ", "+", " ", "1"}], "]"}], "[", "t", "]"}],
                   "\n", "                        ", ",", "\n", 
                  "                        ", 
                  RowBox[{
                   RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}]}], "\n", 
                 "                      ", "]"}], " ", "+", "\n", 
                "                      ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"i", " ", ">", " ", 
                   RowBox[{"-", "nN"}]}], ",", "\n", 
                  "                        ", 
                  RowBox[{
                   RowBox[{"u", "[", 
                    RowBox[{"i", " ", "-", " ", "1"}], "]"}], "[", "t", "]"}],
                   "\n", "                        ", ",", "\n", 
                  "                        ", 
                  RowBox[{
                   RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}]}], "\n", 
                 "                      ", "]"}]}], "\n", 
               "                  ", ")"}], " ", "-", " ", 
              RowBox[{"2", " ", "*", " ", 
               RowBox[{
                RowBox[{"u", "[", "i", "]"}], "[", "t", "]"}]}]}], "\n", 
             "              ", ")"}]}]}]}], "\n", "        ", ",", "\n", 
         "        ", 
