Cell["Minimum spacing", \
"Subsubsection",ExpressionUUID->"82fd2d8d-b2c2-4fb4-8c12-390532ea0061"],

Cell["\<\
continuousBands finds continuous imbalance intervals. minimumSpacingData \
finds the minimum spacing at a 0.1 imbalance tolerance. \
PropagationMinimumSpacing formats these spacings and intervals. \
PlotMinimumSpacing loads and plots each summary.\
\>", "Text",ExpressionUUID->"2f09b783-ff52-492d-818b-bb0080738d26"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"continuousBands", "[", 
     RowBox[{"values_", ",", " ", "coordinates_", ",", " ", "width_"}], "]"}],
     " ", ":=", " ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Split", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"values", ",", " ", "True"}], "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"#2", " ", "==", " ", 
          RowBox[{"#1", " ", "+", " ", "1"}]}], " ", "&"}]}], " ", "]"}], ",",
       " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"coordinates", "[", 
          RowBox[{"[", 
           RowBox[{"Last", "[", "#1", "]"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"coordinates", "[", 
          RowBox[{"[", 
           RowBox[{"First", "[", "#1", "]"}], "]"}], "]"}]}], " ", ">=", " ", 
        
        RowBox[{"width", " ", "-", " ", 
         RowBox[{"10", "^", 
          RowBox[{"(", 
           RowBox[{"-", "12"}], ")"}]}]}]}], " ", "&"}]}], " ", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"minimumSpacingData", "[", 
    RowBox[{"data_", ",", " ", 
     RowBox[{"width_", ":", "0.1"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "classes", ",", " ", "bounds", ",", " ", "labels", ",", " ", "counts", ",",
        " ", "largest", ",", " ", "mask", ",", " ", "axes", ",", " ", "x", ",",
        " ", "y", ",", " ", "z", ",", " ", "candidates", ",", " ", "runs", ",",
        " ", "band"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"classes", " ", "=", " ", 
       RowBox[{"data", "[", "\"\<classes\>\"", "]"}]}], ";", " ", 
      RowBox[{"bounds", " ", "=", " ", 
       RowBox[{"data", "[", "\"\<bounds\>\"", "]"}]}], ";", " ", 
      RowBox[{"labels", " ", "=", " ", 
       RowBox[{"MorphologicalComponents", "[", 
        RowBox[{
         RowBox[{"Image3D", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Boole", "[", 
               RowBox[{"#1", " ", "==", " ", "1"}], "]"}], " ", "&"}], " ", ",",
              " ", "classes", ",", " ", 
             RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", "\"\<Bit\>\""}], 
          "]"}], ",", " ", 
         RowBox[{"CornerNeighbors", " ", "->", " ", "True"}]}], "]"}]}], ";", 
      " ", 
      RowBox[{"counts", " ", "=", " ", 
       RowBox[{"KeyDrop", "[", 
        RowBox[{
         RowBox[{"Counts", "[", 
          RowBox[{"Flatten", "[", "labels", "]"}], "]"}], ",", " ", "0"}], 
        "]"}]}], ";", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"counts", " ", "===", " ", 
         RowBox[{"Association", "[", "]"}]}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", " ", 
      RowBox[{"largest", " ", "=", " ", 
       RowBox[{"First", "[", 
        RowBox[{"MaximalBy", "[", 
         RowBox[{
          RowBox[{"Keys", "[", "counts", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"counts", "[", "#1", "]"}], " ", "&"}]}], " ", "]"}], 
        "]"}]}], ";", " ", 
      RowBox[{"mask", " ", "=", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", " ", "==", " ", "largest"}], " ", "&"}], " ", ",", 
         " ", "labels", ",", " ", 
         RowBox[{"{", "3", "}"}]}], "]"}]}], ";", " ", 
      RowBox[{"axes", " ", "=", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subdivide", "[", 
