e97bf120f1fa"],

Cell["\<\
Sweep spacing and conductance imbalance to map front anchoring in the cubic \
model.\
\>", "Text",ExpressionUUID->"a4d3eca2-7120-4948-acb4-686cc6e485a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vals3o", ",", "coords3o"}], "}"}], "=", 
   RowBox[{"theCut", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"checkDriftCubic", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalDelta]x", "\[Rule]", 
           RowBox[{
            SqrtBox["#1"], " ", "\[ScriptL]"}]}], ",", 
          RowBox[{"\[ScriptR]", "\[Rule]", "#2"}], ",", 
          RowBox[{"\[Tau]", "\[Rule]", "0.01`"}]}], "}"}], ",", "False", ",", 
        
        RowBox[{"0.5`", " ", "\[CapitalDelta]x"}]}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"RsGc", ",", "0.1`", ",", "20"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[ScriptR]", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", "4", ",", "8", ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", "r", ",", "s"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"boundaryPlot", "=", 
   RowBox[{"plotCutBoundary2d", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals3o", ",", "coords3o"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"RsGc", ",", "0.1`", ",", "20"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[ScriptR]", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", "r", ",", "s"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"White", ",", "White", ",", "LightGray"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Dotted", ",", "Thick"}], "}"}]}], "]"}]}], ";"}]], "Input",
