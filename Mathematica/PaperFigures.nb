Cell["Helper code to plot the IV curves", "Subsubsection",
 CellChangeTimes->{{3.981504968690433*^9, 3.981504974419549*^9}, {
  3.9815051257910223`*^9, 3.981505133677784*^9}, {3.981514055290903*^9, 
