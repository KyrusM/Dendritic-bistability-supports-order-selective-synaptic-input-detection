           RowBox[{"bounds", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", " ", 
           RowBox[{"Dimensions", "[", "classes", "]"}]}], "}"}]}], "]"}]}], ";",
       " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "=", " ", 
       "axes"}], ";", " ", 
      RowBox[{"DeleteMissing", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"candidates", " ", "=", " ", 
